def _safe_correlation(x: np.ndarray, y: np.ndarray, method: str = "pearson") -> float:
    """Return a finite correlation when possible, otherwise NaN."""
    from scipy.stats import pearsonr, spearmanr

    x = np.asarray(x, dtype=float)
    y = np.asarray(y, dtype=float)
    mask = np.isfinite(x) & np.isfinite(y)
    x, y = x[mask], y[mask]
    if x.size < 3 or np.nanstd(x) <= 1e-12 or np.nanstd(y) <= 1e-12:
        return np.nan
    if method == "spearman":
        result = spearmanr(x, y)
        return float(getattr(result, "correlation", result[0]))
    result = pearsonr(x, y)
    return float(getattr(result, "statistic", result[0]))


def _main_effect_importance_vector(model: GAMModelWrapper,
                                   X_reference: np.ndarray) -> pd.DataFrame:
    """Return a complete, comparable main-effect importance vector."""
    table = _get_term_importance_table(model, X_reference)
    main = table[table["TermType"] == "Main effect"].copy()
    importance_map = {
        tuple(row["FeatureIndices"])[0]: float(row["Importance"])
        for _, row in main.iterrows()
        if isinstance(row["FeatureIndices"], tuple) and len(row["FeatureIndices"]) == 1
    }
    total_importance = float(table["Importance"].sum())
    main_total = float(sum(importance_map.values()))

    rows = []
    for feature_idx, feature in enumerate(FEATURE_COLUMNS):
        raw = float(importance_map.get(feature_idx, 0.0))
        rows.append({
            "FeatureIndex": feature_idx,
            "Feature": feature.replace("Steam/Biomass", "S/B"),
            "RawImportance": raw,
            "ShareOfAllTerms": raw / total_importance if total_importance > 0 else np.nan,
            "ShareWithinMainEffects": raw / main_total if main_total > 0 else np.nan,
        })
    result = pd.DataFrame(rows)
    result["RankWithinMainEffects"] = (
        result["RawImportance"].rank(method="average", ascending=False)
    )
    return result


def _continuous_pair_importance_table(model: GAMModelWrapper,
                                      X_reference: np.ndarray) -> pd.DataFrame:
    """Return all retained continuous-continuous pairwise terms."""
    table = _get_term_importance_table(model, X_reference)
    total_importance = float(table["Importance"].sum())
    rows = []
    for _, row in table.iterrows():
        term = row["FeatureIndices"]
        if not (isinstance(term, tuple) and len(term) == 2):
            continue
        pair = tuple(sorted(int(v) for v in term))
        if not all(idx < N_CONTINUOUS for idx in pair):
            continue
        rows.append({
            "PairKey": f"{pair[0]}-{pair[1]}",
            "Pair": _format_term_name(pair),
            "FeatureI": pair[0],
            "FeatureJ": pair[1],
            "RawImportance": float(row["Importance"]),
            "ShareOfAllTerms": (
                float(row["Importance"]) / total_importance
                if total_importance > 0 else np.nan
            ),
        })
    if not rows:
        return pd.DataFrame(columns=[
            "PairKey", "Pair", "FeatureI", "FeatureJ",
            "RawImportance", "ShareOfAllTerms", "Rank",
        ])
    result = pd.DataFrame(rows).sort_values("RawImportance", ascending=False)
    result["Rank"] = np.arange(1, len(result) + 1)
    return result.reset_index(drop=True)


def _common_raw_grid(df_target: pd.DataFrame, feature_idx: int,
                     n_grid: int, quantiles: Tuple[float, float]) -> np.ndarray:
    """Build a common raw-scale grid from the central observed range."""
    values = df_target[CONTINUOUS_COLS[feature_idx]].astype(float).to_numpy()
    lo, hi = np.quantile(values, quantiles)
    if not np.isfinite(lo) or not np.isfinite(hi):
        raise ValueError(f"Non-finite grid limits for {CONTINUOUS_COLS[feature_idx]}")
    if hi <= lo:
        lo, hi = float(np.min(values)), float(np.max(values))
    if hi <= lo:
        hi = lo + 1e-9
    return np.linspace(float(lo), float(hi), int(n_grid))


def _evaluate_main_effect_on_raw_grid(model: GAMModelWrapper,
                                      scaler: StandardScaler,
                                      reference_df: pd.DataFrame,
                                      feature_idx: int,
                                      raw_grid: np.ndarray) -> np.ndarray:
    """Evaluate one isolated EBM/GA2M main-effect term on a common raw grid."""
    X_reference = transform_features(reference_df, scaler)
    ebm = _unwrap_ebm(model)
    term_features = _get_ebm_term_features(ebm)
    term_map = {
        term[0]: term_idx
        for term_idx, term in enumerate(term_features)
        if len(term) == 1
    }
    if feature_idx not in term_map:
        return np.zeros_like(raw_grid, dtype=float)

    term_idx = term_map[feature_idx]
    observed_terms = _eval_ebm_terms(ebm, X_reference)
    baseline = float(np.mean(observed_terms[:, term_idx]))

    scaled_grid = (
        (np.asarray(raw_grid, dtype=float) - scaler.mean_[feature_idx])
        / scaler.scale_[feature_idx]
    )
    X_batch = np.repeat(
        X_reference[np.newaxis, :, :], len(scaled_grid), axis=0
    )
    X_batch[:, :, feature_idx] = scaled_grid[:, np.newaxis]
    evaluated = _eval_ebm_terms(
        ebm, X_batch.reshape(-1, X_reference.shape[1])
    )[:, term_idx]
    curve = evaluated.reshape(len(scaled_grid), X_reference.shape[0]).mean(axis=1)
    return np.asarray(curve - baseline, dtype=float)


def _curve_stability_metrics(full_curve: np.ndarray,
                             bootstrap_curve: np.ndarray) -> Dict[str, float]:
    """Compare one bootstrap main-effect curve with the final full-data curve."""
    full_curve = np.asarray(full_curve, dtype=float)
    bootstrap_curve = np.asarray(bootstrap_curve, dtype=float)
    scale = max(float(np.ptp(full_curve)), float(np.std(full_curve)), 1e-12)
    nrmse = float(np.sqrt(np.mean((bootstrap_curve - full_curve) ** 2)) / scale)

    full_diff = np.diff(full_curve)
    boot_diff = np.diff(bootstrap_curve)
    tolerance = max(float(np.ptp(full_curve)) * 1e-4, 1e-10)
    informative = np.abs(full_diff) > tolerance
    if np.any(informative):
        direction_agreement = float(np.mean(
            np.sign(full_diff[informative]) == np.sign(boot_diff[informative])
        ))
    else:
        direction_agreement = np.nan

    return {
        "PearsonCorrelation": _safe_correlation(full_curve, bootstrap_curve, "pearson"),
        "SpearmanCorrelation": _safe_correlation(full_curve, bootstrap_curve, "spearman"),
        "NormalizedRMSE": nrmse,
        "DirectionAgreement": direction_agreement,
    }


