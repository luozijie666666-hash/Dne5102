    fig.savefig(stem + ".pdf", facecolor="white")
    fig.savefig(stem + ".svg", facecolor="white")
    plt.close(fig)

def generate_best_model_analysis(df_results: pd.DataFrame, df: pd.DataFrame,
                                 models: List[GAMModelWrapper], save_dir: str) -> None:
    """
    Refit the selected model for interpretation and regenerate publication figures.

    Cross-validation, model selection, prediction metrics, fold assignments, and
    random seeds are unchanged. This function modifies only the interpretation
    outputs generated after those numerical results have already been obtained.
    """
    print("\n[7] Generating publication-quality interpretability visualizations...")
    interpretation_targets = ["H2", "CO", "CO2", "CH4"]
    feature_tables: Dict[str, pd.DataFrame] = {}
    shape_tables: Dict[str, pd.DataFrame] = {}
    ice_tables: Dict[str, Dict[str, pd.DataFrame]] = {}
    interaction_records: Dict[str, List[Dict[str, Any]]] = {}

    summary_dir = os.path.join(save_dir, "interpretability_summary")
    ensure_dir(summary_dir)

    for target in interpretation_targets:
        print(f"\n  Target: {target}")
        df_target = df_results[df_results["Target"] == target]
        df_agg = df_target.groupby("Model").agg({"PhysRate": "mean", "R2": "mean"}).reset_index()
        df_perfect = df_agg[df_agg["PhysRate"] >= 99.9]
        if df_perfect.empty:
            df_perfect = df_agg.nlargest(3, "PhysRate")
            print("    No model with 100% PhysRate; using the three highest-PhysRate models")
        df_best = df_perfect.nlargest(1, "R2")
        best_model_name = df_best["Model"].iloc[0]
        best_r2 = df_best["R2"].iloc[0]
        best_phys = df_best["PhysRate"].iloc[0]
        print(f"    Best model: {best_model_name} (R2={best_r2:.4f}, PhysRate={best_phys:.1f}%)")

        best_model = None
        for candidate in models:
            if candidate.name == best_model_name:
                best_model = candidate.clone()
                break
        if best_model is None:
            print(f"    ERROR: Model {best_model_name} not found")
            continue

        df_target_data = split_target(df, target)
        scaler = fit_scaler(df_target_data)
        X = transform_features(df_target_data, scaler)
        y = df_target_data[target].values
        best_model.fit(X, y, target=target)

        best_dir = os.path.join(save_dir, target, "best_model_analysis")
        ensure_dir(best_dir)

        print("    Generating term-importance figure...")
        feature_tables[target] = plot_feature_importance(best_model, best_dir, target, X=X, top_n=15)

        print("    Generating main-effect functions...")
        shape_tables[target] = plot_shape_functions(best_model, X, scaler, target, best_dir)

        print("    Generating ICE/PDP figures...")
        ice_tables[target] = plot_ice_pdp(best_model, X, scaler, target, best_dir)

        print("    Generating isolated pairwise-interaction surfaces...")
        interaction_records[target] = plot_pairwise_interaction_surfaces(best_model, X, scaler, target, best_dir, top_n=2, grid_size=50)

        pd.DataFrame([{"Target": target, "Best_Model": best_model_name, "R2": best_r2, "PhysRate": best_phys}]).to_excel(
            os.path.join(best_dir, "best_model_info.xlsx"), index=False
        )
        print(f"    Saved to: {best_dir}")

    print("\n  Generating cross-target manuscript figures...")
    plot_feature_importance_summary(feature_tables, summary_dir, top_n=12)
    plot_interaction_summary(interaction_records, summary_dir)
    export_manuscript_figures(save_dir, feature_tables, shape_tables, ice_tables, interaction_records)
    print(f"  Interpretability summary saved to: {summary_dir}")

def _copy_if_exists(src_stem: str, dst_stem: str, exts=(".png", ".pdf", ".svg", ".xlsx")) -> None:
    for ext in exts:
        src = src_stem + ext
        dst = dst_stem + ext
        if os.path.exists(src):
            ensure_dir(os.path.dirname(dst))
            shutil.copy2(src, dst)


def _panel_sequence(n: int) -> List[str]:
    return [f"({chr(97 + i)})" for i in range(n)]


def _plot_shape_or_ice_summary(data_dict: Dict[str, Any], figure_path_stem: str,
                               excel_path: str, features: List[str],
                               targets: List[str], kind: str = "shape") -> None:
    n_rows = len(targets)
    n_cols = len(features)
    fig, axes = plt.subplots(n_rows, n_cols, figsize=(2.8 * n_cols, 2.35 * n_rows), constrained_layout=True)
    if n_rows == 1:
        axes = np.array([axes])
    labels = _panel_sequence(n_rows * n_cols)
    panel_idx = 0
    for row_idx, target in enumerate(targets):
        for col_idx, feature in enumerate(features):
            ax = axes[row_idx, col_idx]
            if kind == "shape":
                df_plot = data_dict[target]
                sub = df_plot[df_plot["Feature"] == feature].copy()
                ax.plot(sub["X"], sub["MainEffectContribution"], color=COLORS[0], linewidth=1.7)
                ax.fill_between(sub["X"], 0, sub["MainEffectContribution"], color=COLORS[0], alpha=0.14, linewidth=0)
                ax.axhline(0, color="black", linestyle="--", linewidth=0.75, alpha=0.7)
                ylabel = _target_contribution_label(target, "Main-effect contribution")
            else:
                item = data_dict[target]
                pdp_df = item["pdp"]
