def _load_saved_best_fold_predictions(output_dir: str) -> Dict[str, Dict[str, Dict[str, Any]]]:
    """Load previously generated best-fold predictions without rerunning CV."""
    loaded: Dict[str, Dict[str, Dict[str, Any]]] = {}
    for target in TARGETS:
        loaded[target] = {}
        for model_name in MONOTONIC_MODEL_NAMES:
            path = os.path.join(output_dir, target, f"{model_name}_{target}_predictions.xlsx")
            if not os.path.exists(path):
                continue
            frame = pd.read_excel(path)
            required = {"Set", "Actual", "Predicted"}
            if not required.issubset(frame.columns):
                continue
            train = frame[frame["Set"].astype(str).str.lower() == "train"]
            test = frame[frame["Set"].astype(str).str.lower() == "test"]
            if train.empty or test.empty:
                continue
            loaded[target][model_name] = {
                "y_train": train["Actual"].to_numpy(dtype=float),
                "y_pred_train": train["Predicted"].to_numpy(dtype=float),
                "y_test": test["Actual"].to_numpy(dtype=float),
                "y_pred_test": test["Predicted"].to_numpy(dtype=float),
                "fold": np.nan,
            }
    return loaded




