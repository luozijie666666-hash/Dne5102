def _summarize_split_shape(sub: pd.DataFrame, n_grid: int = 120) -> pd.DataFrame:
    """Align split-specific curves and summarize their between-split variation."""
    split_columns = [column for column in ("Seed", "Fold") if column in sub.columns]
    if not split_columns:
        result = sub[["X", "MainEffectContribution"]].copy().sort_values("X")
        result = result.rename(columns={"MainEffectContribution": "Mean"})
        result["SD"] = 0.0
        result["Median"] = result["Mean"]
        result["CI2_5"] = result["Mean"]
        result["CI97_5"] = result["Mean"]
        result["Split_Count"] = 1
        return result

    curves = []
    grouped_curves = list(sub.groupby(split_columns, sort=True))
    common_min = max(float(group["X"].min()) for _, group in grouped_curves)
    common_max = min(float(group["X"].max()) for _, group in grouped_curves)
    if not common_max > common_min:
        raise RuntimeError("The split-specific main-effect grids do not overlap")
    common_x = np.linspace(common_min, common_max, n_grid)
    for split_key, group in grouped_curves:
        group = group.sort_values("X").drop_duplicates("X")
        values = np.interp(
            common_x,
            group["X"].to_numpy(dtype=float),
            group["MainEffectContribution"].to_numpy(dtype=float),
        )
        curves.append(values)
    matrix = np.vstack(curves)
    return pd.DataFrame({
        "X": common_x,
        "Mean": np.mean(matrix, axis=0),
        "SD": np.std(matrix, axis=0, ddof=1) if len(matrix) > 1 else 0.0,
        "Median": np.median(matrix, axis=0),
        "CI2_5": np.quantile(matrix, 0.025, axis=0),
        "CI97_5": np.quantile(matrix, 0.975, axis=0),
        "Split_Count": len(matrix),
    })


