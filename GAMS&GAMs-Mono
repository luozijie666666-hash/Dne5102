def plot_ice_pdp(model: GAMModelWrapper, X: np.ndarray, scaler: StandardScaler,
                 target: str, save_dir: str, n_ice_lines: int = 50,
                 n_grid: int = 60) -> Dict[str, pd.DataFrame]:
    """
    Plot ICE curves for a reproducible sample and PDP curves averaged over all observations.

    A local random generator with the unchanged global seed is used only for selecting
    displayed ICE lines; it does not alter the random state used by model training.
    """
    ensure_dir(save_dir)
    rng = np.random.default_rng(CFG.RANDOM_STATE)
    n_display = min(n_ice_lines, X.shape[0])
    sample_indices = np.sort(rng.choice(X.shape[0], n_display, replace=False))

    pdp_records = []
    ice_records = []
    fig, axes = plt.subplots(2, 4, figsize=(12.8, 6.6))
    axes = axes.flatten()

    for feature_idx in range(N_CONTINUOUS):
        ax = axes[feature_idx]
        feature_name = CONTINUOUS_COLS[feature_idx]
        x_scaled = _make_feature_grid(X, feature_idx, n_grid)
        x_original = inverse_transform_feature(scaler, feature_idx, x_scaled)

        X_all = np.repeat(X[np.newaxis, :, :], n_grid, axis=0)
        X_all[:, :, feature_idx] = x_scaled[:, np.newaxis]
        all_predictions = model.predict(X_all.reshape(-1, X.shape[1])).reshape(n_grid, X.shape[0])
        pdp = np.mean(all_predictions, axis=1)

        X_display = X[sample_indices]
        X_ice = np.repeat(X_display[np.newaxis, :, :], n_grid, axis=0)
        X_ice[:, :, feature_idx] = x_scaled[:, np.newaxis]
        ice_matrix = model.predict(X_ice.reshape(-1, X.shape[1])).reshape(n_grid, n_display).T

        for line_idx, curve in enumerate(ice_matrix):
            ax.plot(x_original, curve, color=COLORS[1], alpha=0.12, linewidth=0.55)
            for xv, yv in zip(x_original, curve):
                ice_records.append({"Target": target, "Feature": feature_name, "SampleIndex": int(sample_indices[line_idx]), "X": float(xv), "ICE": float(yv)})

        ax.plot(x_original, pdp, color=COLORS[0], linewidth=2.2, label="PDP (all observations)")
        ax.set_xlabel(FEATURE_UNITS.get(feature_name, feature_name))
        ax.set_ylabel(f"Predicted {TARGET_UNITS.get(target, target)}", fontsize=9)
        ax.set_title(f"({chr(97 + feature_idx)}) {feature_name.replace('Steam/Biomass', 'S/B')}", loc="left", fontsize=10.5, fontweight="bold")
        ax.grid(True, linestyle="--", linewidth=0.4, alpha=0.28)
        ax.tick_params(which="both", direction="in", top=True, right=True)
        _add_observation_rug(ax, inverse_transform_feature(scaler, feature_idx, X[:, feature_idx]))
        if feature_idx == 0:
            ax.legend(loc="best", fontsize=8, frameon=False)

        for xv, yv in zip(x_original, pdp):
            pdp_records.append({"Target": target, "Feature": feature_name, "X": float(xv), "PDP": float(yv)})

    fig.suptitle(f"{model.name} ICE/PDP analysis: {target}", fontsize=12, fontweight="bold", y=0.995)
    fig.tight_layout(rect=[0, 0, 1, 0.965])
    stem = os.path.join(save_dir, f"{model.name}_{target}_ice_pdp")
    fig.savefig(stem + ".png", dpi=600, bbox_inches="tight", facecolor="white")
    fig.savefig(stem + ".pdf", bbox_inches="tight", facecolor="white")
    fig.savefig(stem + ".svg", bbox_inches="tight", facecolor="white")
    plt.close(fig)

    pdp_df = pd.DataFrame(pdp_records)
    ice_df = pd.DataFrame(ice_records)
    with pd.ExcelWriter(stem + ".xlsx") as writer:
        pdp_df.to_excel(writer, sheet_name="PDP_all_observations", index=False)
        ice_df.to_excel(writer, sheet_name="ICE_50_samples", index=False)
    return {"pdp": pdp_df, "ice": ice_df}

def _compute_pairwise_interaction_surface(model: GAMModelWrapper, X: np.ndarray,
                                          scaler: StandardScaler, term_idx: int,
                                          feature_i: int, feature_j: int,
                                          grid_size: int = 50) -> Dict[str, Any]:
    """Evaluate one retained GA2M pairwise term on a continuous/binary grid."""
    ebm = _unwrap_ebm(model)
    observed_terms = _eval_ebm_terms(ebm, X)
    observed_mean = float(np.mean(observed_terms[:, term_idx]))

    def build_grid(feature_idx: int) -> Tuple[np.ndarray, np.ndarray]:
        if feature_idx < N_CONTINUOUS:
            scaled = _make_feature_grid(X, feature_idx, grid_size)
            original = inverse_transform_feature(scaler, feature_idx, scaled)
        else:
            # Bed material is represented by binary one-hot indicators.
            scaled = np.asarray([0.0, 1.0], dtype=float)
            original = scaled.copy()
        return scaled, original

    x_scaled, x_original = build_grid(feature_i)
    y_scaled, y_original = build_grid(feature_j)
    n_x, n_y = len(x_scaled), len(y_scaled)
    Z = np.empty((n_y, n_x), dtype=float)

    for row_idx, y_value in enumerate(y_scaled):
        X_row = np.repeat(X[np.newaxis, :, :], n_x, axis=0)
        X_row[:, :, feature_i] = x_scaled[:, np.newaxis]
        X_row[:, :, feature_j] = y_value
        term_values = _eval_ebm_terms(
            ebm, X_row.reshape(-1, X.shape[1])
        )[:, term_idx]
        Z[row_idx, :] = (
            term_values.reshape(n_x, X.shape[0]).mean(axis=1) - observed_mean
        )

    X_mesh, Y_mesh = np.meshgrid(x_original, y_original)

    def observed_values(feature_idx: int) -> np.ndarray:
        if feature_idx < N_CONTINUOUS:
            return inverse_transform_feature(
                scaler, feature_idx, X[:, feature_idx]
            )
        return np.asarray(X[:, feature_idx], dtype=float)

    return {
        "term_idx": int(term_idx),
        "feature_i": int(feature_i),
        "feature_j": int(feature_j),
        "feature_i_name": FEATURE_COLUMNS[feature_i],
        "feature_j_name": FEATURE_COLUMNS[feature_j],
        "feature_i_is_categorical": bool(feature_i >= N_CONTINUOUS),
        "feature_j_is_categorical": bool(feature_j >= N_CONTINUOUS),
        "x_scaled": x_scaled,
        "y_scaled": y_scaled,
        "x_original": x_original,
        "y_original": y_original,
        "X_mesh": X_mesh,
        "Y_mesh": Y_mesh,
        "Z": Z,
        "observed_x": observed_values(feature_i),
        "observed_y": observed_values(feature_j),
    }

def _draw_interaction_panel(ax, record: Dict[str, Any], target: str,
                            vlim: float, panel_label: str = None,
                            show_title: bool = True):
    """Draw one isolated pairwise interaction panel and return the mappable."""
    vlim = max(float(vlim), 1e-12)
    levels = np.linspace(-vlim, vlim, 21)
    norm = TwoSlopeNorm(vmin=-vlim, vcenter=0.0, vmax=vlim)
    contour = ax.contourf(
        record["X_mesh"], record["Y_mesh"], record["Z"],
        levels=levels, cmap="RdBu_r", norm=norm, extend="both",
    )
    zero_min, zero_max = float(np.nanmin(record["Z"])), float(np.nanmax(record["Z"]))
    if zero_min <= 0 <= zero_max:
        ax.contour(record["X_mesh"], record["Y_mesh"], record["Z"],
                   levels=[0], colors="black", linewidths=0.85, linestyles="-")

    ax.scatter(record["observed_x"], record["observed_y"], s=7,
               facecolors="none", edgecolors="black", linewidths=0.35,
               alpha=0.22, rasterized=True)
    ax.set_xlabel(FEATURE_UNITS.get(record["feature_i_name"], record["feature_i_name"]))
    ax.set_ylabel(FEATURE_UNITS.get(record["feature_j_name"], record["feature_j_name"]))
    if show_title:
        pair_name = (
            f"{record['feature_i_name'].replace('Steam/Biomass', 'S/B')} x "
            f"{record['feature_j_name'].replace('Steam/Biomass', 'S/B')}"
        )
        prefix = f"{panel_label} " if panel_label else ""
        ax.set_title(f"{prefix}{pair_name}", loc="left", fontsize=10.2, fontweight="bold")
    ax.tick_params(which="both", direction="in", top=True, right=True)
    ax.grid(False)
    return contour


def plot_pairwise_interaction_surfaces(model: GAMModelWrapper, X: np.ndarray,
                                       scaler: StandardScaler, target: str,
                                       save_dir: str, top_n: int = 3,
                                       grid_size: int = 50) -> List[Dict[str, Any]]:
    """
    Rank and visualize isolated continuous-variable pairwise terms of GA2M-Mono.

    The surfaces exclude the corresponding main effects and show deviations from
    additive expectation. Only interactions between the eight continuous inputs
    are considered for the manuscript analysis; bed-material interactions remain
    available in the complete term-importance table.
    """
    ensure_dir(save_dir)
    interaction_dir = os.path.join(save_dir, "pairwise_interaction_contributions")
    ensure_dir(interaction_dir)

    importance_df = _get_term_importance_table(model, X)
    all_continuous_pairs = importance_df[
        importance_df["FeatureIndices"].apply(
            lambda term: isinstance(term, tuple) and len(term) == 2 and all(idx < N_CONTINUOUS for idx in term)
        )
    ].copy().reset_index(drop=True)
    continuous_pairs = all_continuous_pairs.head(top_n).copy().reset_index(drop=True)
    if continuous_pairs.empty:
        print(f"      No continuous-variable pairwise terms were found for {target}.")
        return []

    records = []
    print(f"      Extracting the top {len(continuous_pairs)} isolated pairwise terms for {target}...")
    for rank, row in continuous_pairs.iterrows():
        feature_i, feature_j = tuple(row["FeatureIndices"])
        print(f"        [{rank + 1}/{len(continuous_pairs)}] {str(row['Term']).replace(' x ', ' x ')}")
        record = _compute_pairwise_interaction_surface(
            model=model,
            X=X,
            scaler=scaler,
            term_idx=int(row["TermIndex"]),
            feature_i=int(feature_i),
            feature_j=int(feature_j),
            grid_size=grid_size,
        )
        record["rank"] = int(rank + 1)
        record["importance"] = float(row["Importance"])
        record["target"] = target
        records.append(record)

    target_vlim = max(float(np.nanmax(np.abs(record["Z"]))) for record in records)

    # One publication-ready panel per interaction.
    for record in records:
        fig, ax = plt.subplots(figsize=(5.5, 4.5))
        contour = _draw_interaction_panel(
            ax, record, target, target_vlim,
            panel_label=f"Rank {record['rank']}:", show_title=True,
        )
        cbar = fig.colorbar(contour, ax=ax, pad=0.025, fraction=0.05)
        cbar.set_label(_target_contribution_label(target, "Pairwise contribution"), fontsize=9.5)
        cbar.ax.tick_params(labelsize=8)
        ax.text(0.015, 0.015, f"Mean |term contribution| = {record['importance']:.3f}",
                transform=ax.transAxes, fontsize=8, ha="left", va="bottom",
                bbox=dict(facecolor="white", edgecolor="none", alpha=0.78, pad=2.0))
        fig.tight_layout()
        pair_stub = (
            f"{record['feature_i_name']}_{record['feature_j_name']}"
            .replace("/", "_").replace(" ", "_")
        )
        stem = os.path.join(interaction_dir, f"rank_{record['rank']}_{target}_{pair_stub}")
        fig.savefig(stem + ".png", dpi=600, bbox_inches="tight", facecolor="white")
        fig.savefig(stem + ".pdf", bbox_inches="tight", facecolor="white")
        fig.savefig(stem + ".svg", bbox_inches="tight", facecolor="white")
        plt.close(fig)

        export_rows = []
        for row_idx, y_value in enumerate(record["y_original"]):
            for col_idx, x_value in enumerate(record["x_original"]):
                export_rows.append({
                    "Target": target,
                    "Rank": record["rank"],
                    "Term": _format_term_name((record["feature_i"], record["feature_j"])),
                    "X": float(x_value),
                    "Y": float(y_value),
                    "PairwiseContribution": float(record["Z"][row_idx, col_idx]),
                })
        pd.DataFrame(export_rows).to_excel(stem + ".xlsx", index=False)

    # Three-panel target-specific figure for the Supplementary Information.
    fig, axes = plt.subplots(1, len(records), figsize=(5.0 * len(records), 4.25), squeeze=False)
    axes = axes.flatten()
    contour = None
    for idx, record in enumerate(records):
        contour = _draw_interaction_panel(
            axes[idx], record, target, target_vlim,
            panel_label=f"({chr(97 + idx)})", show_title=True,
        )
    if contour is not None:
        cbar = fig.colorbar(contour, ax=axes.tolist(), pad=0.018, fraction=0.025)
        cbar.set_label(_target_contribution_label(target, "Pairwise contribution"), fontsize=9.5)
        cbar.ax.tick_params(labelsize=8)
    fig.suptitle(f"Leading GA2M-Mono pairwise contributions: {target}",
                 fontsize=11.5, fontweight="bold", y=1.01)
    fig.subplots_adjust(left=0.06, right=0.91, bottom=0.14, top=0.88, wspace=0.28)
    stem = os.path.join(interaction_dir, f"{target}_top_{len(records)}_pairwise_interactions")
    fig.savefig(stem + ".png", dpi=600, bbox_inches="tight", facecolor="white")
    fig.savefig(stem + ".pdf", bbox_inches="tight", facecolor="white")
    fig.savefig(stem + ".svg", bbox_inches="tight", facecolor="white")
    plt.close(fig)

    ranking_export = all_continuous_pairs.copy()
    ranking_export["FeatureIndices"] = ranking_export["FeatureIndices"].apply(
        lambda value: ",".join(map(str, value))
    )
    ranking_export.to_excel(
        os.path.join(interaction_dir, f"{target}_continuous_pairwise_ranking.xlsx"), index=False
    )
    return records


