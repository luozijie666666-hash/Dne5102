def _native_main_effect_curve(model: GAMModelWrapper, X: np.ndarray,
                              feature_idx: int, x_scaled: np.ndarray) -> np.ndarray:
    """Evaluate one centered intrinsic additive term from the fitted model."""
    if isinstance(model, (EBMWrapper, GA2MWrapper)):
        ebm = _unwrap_ebm(model)
        term_features = _get_ebm_term_features(ebm)
        term_map = {
            term[0]: term_idx
            for term_idx, term in enumerate(term_features)
            if len(term) == 1
        }
        if feature_idx not in term_map:
            return np.zeros_like(x_scaled, dtype=float)
        term_idx = term_map[feature_idx]
        observed = _eval_ebm_terms(ebm, X)[:, term_idx]
        X_grid = np.repeat(np.median(X, axis=0, keepdims=True), len(x_scaled), axis=0)
        X_grid[:, feature_idx] = x_scaled
        curve = _eval_ebm_terms(ebm, X_grid)[:, term_idx]
        return np.asarray(curve, dtype=float) - float(np.mean(observed))

    if isinstance(model, GAMWrapper):
        X_grid = np.repeat(np.median(X, axis=0, keepdims=True), len(x_scaled), axis=0)
        X_grid[:, feature_idx] = x_scaled
        term_idx = next(
            idx for idx, term in enumerate(model.model.terms)
            if getattr(term, "feature", None) == feature_idx
        )
        coefficient_indices = model.model.terms.get_coef_indices(term_idx)
        coefficients = np.asarray(model.model.coef_[coefficient_indices], dtype=float)
        observed = np.asarray(
            model.model._modelmat(X)[:, coefficient_indices] @ coefficients,
            dtype=float,
        ).reshape(-1)
        curve = np.asarray(
            model.model._modelmat(X_grid)[:, coefficient_indices] @ coefficients,
            dtype=float,
        ).reshape(-1)
        return curve - float(np.mean(observed))

    if isinstance(model, NAMWrapper):
        import torch

        if model.monotonic and model._isotonic_models and feature_idx in model._isotonic_models:
            evaluator = model._isotonic_models[feature_idx]["monotonic"]
            observed = np.asarray(evaluator(X[:, feature_idx]), dtype=float)
            curve = np.asarray(evaluator(x_scaled), dtype=float)
        else:
            with torch.no_grad():
                observed_tensor = torch.tensor(
                    X[:, feature_idx:feature_idx + 1],
                    dtype=torch.float32,
                    device=model._device,
                )
                grid_tensor = torch.tensor(
                    x_scaled.reshape(-1, 1),
                    dtype=torch.float32,
                    device=model._device,
                )
                observed = (
                    model._feature_nns[feature_idx](observed_tensor)
                    .cpu().numpy().reshape(-1)
                )
                curve = (
                    model._feature_nns[feature_idx](grid_tensor)
                    .cpu().numpy().reshape(-1)
                )
        return np.asarray(curve, dtype=float) - float(np.mean(observed))

    raise TypeError(f"Unsupported model for intrinsic main effects: {type(model).__name__}")


def _compute_main_effect_table(model: GAMModelWrapper, X: np.ndarray,
                               scaler: StandardScaler, target: str,
                               n_grid: int = 120) -> pd.DataFrame:
    """Compute centered native additive terms for a model or simplex ensemble."""
    rows = []
    for feature_idx in range(N_CONTINUOUS):
        x_scaled = _make_feature_grid(X, feature_idx, n_grid)
        x_original = inverse_transform_feature(scaler, feature_idx, x_scaled)
        if isinstance(model, WhiteBoxStackingWrapper):
            contribution = np.zeros_like(x_scaled, dtype=float)
            for weight, base_model in zip(model.weights_, model.fitted_base_models_):
                contribution += float(weight) * _native_main_effect_curve(
                    base_model, X, feature_idx, x_scaled
                )
            source = "Simplex_weighted_native_additive_terms"
        else:
            contribution = _native_main_effect_curve(model, X, feature_idx, x_scaled)
            source = "Native_additive_term"
        for xv, yv in zip(x_original, contribution):
            rows.append({
                "Target": target,
                "Feature": CONTINUOUS_COLS[feature_idx],
                "X": float(xv),
                "MainEffectContribution": float(yv),
                "Source": source,
            })
    return pd.DataFrame(rows)


def _get_native_main_effect_importance(model: GAMModelWrapper,
                                       X: np.ndarray) -> pd.DataFrame:
    """Compute comparable mean absolute intrinsic main-effect contributions."""
    rows = []
    for feature_idx, feature_name in enumerate(FEATURE_COLUMNS):
        observed_x = np.asarray(X[:, feature_idx], dtype=float)
        if isinstance(model, WhiteBoxStackingWrapper):
            contribution = np.zeros(len(X), dtype=float)
            for weight, base_model in zip(model.weights_, model.fitted_base_models_):
                contribution += float(weight) * _native_main_effect_curve(
                    base_model, X, feature_idx, observed_x
                )
        else:
            contribution = _native_main_effect_curve(
                model, X, feature_idx, observed_x
            )
        rows.append({
            "Term": feature_name,
            "TermType": "Main effect",
            "FeatureIndices": (feature_idx,),
            "Importance": float(np.mean(np.abs(contribution))),
        })
    return (
        pd.DataFrame(rows)
        .sort_values("Importance", ascending=False)
        .reset_index(drop=True)
    )




def _compute_top_pairwise_records(model: GAMModelWrapper, X: np.ndarray,
                                  scaler: StandardScaler, target: str,
                                  top_n: int = 2,
                                  grid_size: int = 50) -> Tuple[List[Dict[str, Any]], pd.DataFrame]:
    """
    Select the top retained continuous-continuous pairwise terms for Fig. 4.

    Only continuous-continuous interactions are considered here so that Fig. 4
    remains focused on interactions among process variables and biomass
    characteristics. No fallback bed-material interaction is introduced.
    """
    importance_df = _get_term_importance_table(model, X)
    all_pairwise = importance_df[
        importance_df["FeatureIndices"].apply(
            lambda term: isinstance(term, tuple) and len(term) == 2
        )
    ].copy().reset_index(drop=True)

    continuous_pairs = all_pairwise[
        all_pairwise["FeatureIndices"].apply(
            lambda term: all(idx < N_CONTINUOUS for idx in term)
        )
    ].copy().reset_index(drop=True)

    selected = continuous_pairs.head(top_n).copy().reset_index(drop=True)

    records: List[Dict[str, Any]] = []
    print(
        f"      Retained pairwise terms for {target}: "
        f"{len(continuous_pairs)} continuous-continuous / "
        f"{len(all_pairwise)} total"
    )

    for rank, row in selected.iterrows():
        feature_i, feature_j = tuple(row["FeatureIndices"])
        print(
            f"        [{rank + 1}/{len(selected)}] "
            f"{_format_term_name((feature_i, feature_j))}"
        )
        record = _compute_pairwise_interaction_surface(
            model=model,
            X=X,
            scaler=scaler,
            term_idx=int(row["TermIndex"]),
            feature_i=int(feature_i),
            feature_j=int(feature_j),
            grid_size=grid_size,
        )
        record.update({
            "rank": int(rank + 1),
            "importance": float(row["Importance"]),
            "target": target,
            "selection_type": "Continuous-continuous retained term",
        })
        records.append(record)

    ranking = all_pairwise.copy()
    ranking["ContinuousContinuous"] = ranking["FeatureIndices"].apply(
        lambda term: all(idx < N_CONTINUOUS for idx in term)
    )
    chosen = set(selected["TermIndex"].astype(int).tolist())
    ranking["SelectedForFig2"] = ranking["TermIndex"].astype(int).isin(chosen)
    return records, ranking

def _draw_isolated_interaction_panel(ax, record: Dict[str, Any], target: str,
                                     panel_label: str,
                                     vlim: float = None):
    """Draw a retained pairwise contribution on continuous or binary axes."""
    z = np.asarray(record["Z"], dtype=float)
    vlim = max(
        float(np.nanmax(np.abs(z))) if vlim is None else float(vlim),
        1e-9,
    )
    norm = TwoSlopeNorm(vmin=-vlim, vcenter=0.0, vmax=vlim)
    x_is_cat = bool(record.get("feature_i_is_categorical", False))
    y_is_cat = bool(record.get("feature_j_is_categorical", False))

    # Robust for both dense continuous grids and two-state one-hot grids.
    mappable = ax.pcolormesh(
        record["X_mesh"], record["Y_mesh"], z,
        cmap=SCI_DIVERGING_CMAP, norm=norm,
        shading="nearest", rasterized=True,
    )

    if (
        z.shape[0] >= 3 and z.shape[1] >= 3
        and float(np.nanmin(z)) <= 0.0 <= float(np.nanmax(z))
    ):
        ax.contour(
            record["X_mesh"], record["Y_mesh"], z,
            levels=[0.0], colors=SCI_DARK, linewidths=0.65,
        )

    ax.scatter(
        record["observed_x"], record["observed_y"],
        s=6.0, facecolors="none", edgecolors=SCI_DARK,
        linewidths=0.28, alpha=0.18, rasterized=True,
    )

    def label(name: str, categorical: bool) -> str:
        return f"{name} indicator" if categorical else FEATURE_UNITS.get(name, name)

    ax.set_xlabel(label(record["feature_i_name"], x_is_cat), fontsize=8.0, labelpad=3.0)
    ax.set_ylabel(label(record["feature_j_name"], y_is_cat), fontsize=8.0, labelpad=3.0)

    if x_is_cat:
        ax.set_xticks([0.0, 1.0])
        ax.set_xticklabels(["Absent", "Present"], fontsize=7.0)
        ax.set_xlim(-0.10, 1.10)
    if y_is_cat:
        ax.set_yticks([0.0, 1.0])
        ax.set_yticklabels(["Absent", "Present"], fontsize=7.0)
        ax.set_ylim(-0.10, 1.10)

    pair_name = (
        f"{_feature_display_name(record['feature_i_name'])} x "
        f"{_feature_display_name(record['feature_j_name'])}"
    )
    ax.set_title(
        f"{panel_label} {target}: {pair_name}",
        loc="left", fontsize=8.6, fontweight="bold", pad=4,
    )
    _style_panel(ax, grid=False)
    return mappable










