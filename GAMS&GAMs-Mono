def _clean_manuscript_figure_dir(output_dir: str) -> str:
    """Create a clean, self-contained folder containing only manuscript assets."""
    manuscript_dir = os.path.join(output_dir, MANUSCRIPT_FIGURE_DIRNAME)
    ensure_dir(manuscript_dir)
    prefixes = ("Fig1_", "Fig2_", "Fig3_", "Fig4_", "FigS1_", "FigS2_", "FigS3_")
    for name in os.listdir(manuscript_dir):
        if name.startswith(prefixes):
            path = os.path.join(manuscript_dir, name)
            if os.path.isfile(path):
                os.remove(path)
    return manuscript_dir


