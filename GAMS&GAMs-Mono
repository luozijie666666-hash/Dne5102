def _save_figure_bundle(fig, output_dir: str, stem: str) -> None:
    """Save one figure as high-resolution raster and editable vector files."""
    ensure_dir(output_dir)
    base = os.path.join(output_dir, stem)
    fig.savefig(base + ".png", dpi=600, bbox_inches="tight", pad_inches=0.08,
                facecolor="white")
    fig.savefig(base + ".pdf", bbox_inches="tight", pad_inches=0.08,
                facecolor="white")
    fig.savefig(base + ".svg", bbox_inches="tight", pad_inches=0.08,
                facecolor="white")
    saved = [os.path.abspath(base + extension) for extension in (".png", ".pdf", ".svg")]
    missing = [path for path in saved if not os.path.isfile(path) or os.path.getsize(path) == 0]
    if missing:
        raise RuntimeError(f"Figure export failed or produced an empty file: {missing}")
    sizes = ", ".join(
        f"{os.path.splitext(path)[1][1:].upper()}={os.path.getsize(path) / 1024:.1f} KB"
        for path in saved
    )
    _progress_log("FIGURE", f"saved {stem} -> {os.path.dirname(saved[0])} ({sizes})")


