                )


def _term_to_group_feature(term: str) -> str:
    text = str(term).replace(" & ", " x ")
    if text in CONTINUOUS_COLS:
        return text
    if text.startswith("Bed_") or text == "Bed material":
        return "Bed material"
    return ""


def _prepare_main_effect_importance(importance_df: pd.DataFrame,
                                    target: str,
                                    features: List[str]) -> pd.DataFrame:
    if importance_df is None or importance_df.empty:
        return pd.DataFrame(columns=["Target", "Feature", "Importance"])
    df = importance_df.copy()
    if "Term" not in df.columns or "Importance" not in df.columns:
        return pd.DataFrame(columns=["Target", "Feature", "Importance"])
    df["Feature"] = df["Term"].apply(_term_to_group_feature)
    df = df[df["Feature"] != ""].copy()
    if df.empty:
        return pd.DataFrame(columns=["Target", "Feature", "Importance"])
    df["Target"] = target
    identity_columns = [
        column for column in ("Target", "Model", "Seed", "Fold")
        if column in df.columns
    ]
    grouped = (
        df.groupby(identity_columns + ["Feature"], as_index=False)["Importance"]
        .sum()
    )
    denominator = grouped.groupby(identity_columns)["Importance"].transform("sum")
    grouped["Importance"] = np.where(
        denominator > 0, grouped["Importance"] / denominator, 0.0
    )
    grouped = grouped[grouped["Feature"].isin(features)].copy()
    return grouped[identity_columns + ["Feature", "Importance"]]


