            model = model_template.clone()
            model.fit(X, y, target=target)
            stacking_model = None
        else:
            target_data, scaler, X, model, stacking_model = (
                _refit_ga2m_and_stacking_for_interpretation(df, models, target)
            )
        feature_tables[target] = _get_native_main_effect_importance(model, X)
        shape_tables[target] = _compute_main_effect_table(model, X, scaler, target)
        if stacking_model is not None:
            stacking_feature_tables[target] = _get_native_main_effect_importance(
                stacking_model, X
            )
            stacking_shape_tables[target] = _compute_main_effect_table(
                stacking_model, X, scaler, target
