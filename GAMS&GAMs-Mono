def _checkpoint_dir() -> str:
    path = os.path.join(CFG.OUTPUT_DIR, "Results", "Checkpoints")
    ensure_dir(path)
    return path


def _pipeline_complete_marker() -> str:
    return os.path.join(_checkpoint_dir(), "PIPELINE_COMPLETE.txt")


def _mark_pipeline_complete() -> None:
    marker = _pipeline_complete_marker()
    with open(marker, "w", encoding="utf-8") as handle:
        handle.write(
            f"Completed: {time.strftime('%Y-%m-%d %H:%M:%S')}\n"
            f"Export schema: {EXPORT_SCHEMA_VERSION}\n"
            "Validation tables and manuscript figures were exported successfully.\n"
        )
    _progress_log("CHECKPOINT", f"pipeline completion marker saved to {marker}")


def _pipeline_exports_are_current() -> bool:
    marker = _pipeline_complete_marker()
    if not os.path.exists(marker):
        return False
    with open(marker, "r", encoding="utf-8") as handle:
        return f"Export schema: {EXPORT_SCHEMA_VERSION}" in handle.read()


def _has_reusable_validation_results() -> bool:
    """Return True when prior numerical results are sufficient for automatic recovery."""
    validation_checkpoint = os.path.join(
        CFG.OUTPUT_DIR, "Results", "Checkpoints", "validation_checkpoint.joblib"
    )
    if os.path.exists(validation_checkpoint):
        return True
    raw_results = os.path.join(CFG.OUTPUT_DIR, "cv_results_raw.xlsx")
    stacking_weights = os.path.join(
        CFG.OUTPUT_DIR, "Results", "Tables", "Stacking_weights.xlsx"
    )
    return os.path.exists(raw_results) and os.path.exists(stacking_weights)


def _run_preflight_checks() -> None:
    """Fail before model fitting if core figure-layout or aggregation code is invalid."""
    n_cols = 2
    width_ratios = [1.0] * n_cols + [0.055]
    if len(width_ratios) != n_cols + 1:
        raise RuntimeError("Interaction-figure width ratios do not match grid columns")
    fig = plt.figure(figsize=(2.0, 1.0))
    try:
        fig.add_gridspec(
            nrows=max(1, len(INTERPRETATION_TARGETS)),
            ncols=n_cols + 1,
            width_ratios=width_ratios,
        )
    finally:
        plt.close(fig)

    synthetic_shapes = pd.DataFrame({
        "Seed": [0, 0, 0, 1, 1, 1],
        "Fold": [1, 1, 1, 2, 2, 2],
        "X": [0.0, 0.5, 1.0, 0.0, 0.5, 1.0],
        "MainEffectContribution": [0.0, 0.5, 1.0, 0.0, 0.4, 0.8],
    })
    shape_summary = _summarize_split_shape(synthetic_shapes, n_grid=5)
    required = {"X", "Mean", "SD", "CI2_5", "CI97_5", "Split_Count"}
    if not required.issubset(shape_summary.columns) or len(shape_summary) != 5:
        raise RuntimeError("Split-shape uncertainty aggregation preflight failed")
    _progress_log("PREFLIGHT", "figure layout and split-uncertainty checks passed")


def _save_validation_checkpoint(df_all: pd.DataFrame,
                                best_fold_predictions: Dict[str, Any],
                                stacking_diagnostics: pd.DataFrame,
                                stacking_weights: pd.DataFrame,
                                stacking_diversity: pd.DataFrame,
                                split_interpretations: Dict[str, pd.DataFrame]) -> None:
    """Persist every expensive numerical result before any plotting begins."""
    checkpoint_path = os.path.join(_checkpoint_dir(), "validation_checkpoint.joblib")
    joblib.dump({
        "df_all": df_all,
        "best_fold_predictions": best_fold_predictions,
        "stacking_diagnostics": stacking_diagnostics,
        "stacking_weights": stacking_weights,
        "stacking_diversity": stacking_diversity,
        "split_interpretations": split_interpretations,
    }, checkpoint_path, compress=3)
    _progress_log("CHECKPOINT", f"validation checkpoint saved to {checkpoint_path}")


def _load_excel_if_present(path: str, sheet_name=0) -> pd.DataFrame:
    if not os.path.exists(path):
        return pd.DataFrame()
    return pd.read_excel(path, sheet_name=sheet_name)


def _recover_one_split_interpretation(df_target: pd.DataFrame, target: str,
                                      models: List[GAMModelWrapper], seed: int,
                                      split_weights: pd.DataFrame) -> Dict[str, pd.DataFrame]:
    """Rebuild explanations from saved simplex weights without repeating OOF stacking."""
    split_id = seed + 1
    scope = f"RECOVER {target} split {split_id:02d}/{len(CFG.SPLIT_SEEDS):02d}"
    split_checkpoint_dir = os.path.join(_checkpoint_dir(), "recovered_splits")
    ensure_dir(split_checkpoint_dir)
    split_checkpoint = os.path.join(
        split_checkpoint_dir, f"{target}_split_{split_id:02d}.joblib"
    )
    if os.path.exists(split_checkpoint):
        _progress_log(scope, "loaded split checkpoint")
        return joblib.load(split_checkpoint)
    _progress_log(scope, "refitting only the base learners needed for interpretation")
    if split_weights.empty:
        raise RuntimeError(f"Saved stacking weights missing for {target} split {split_id}")
    train_idx, _ = train_test_split(
        np.arange(len(df_target)), test_size=CFG.OUTER_TEST_SIZE,
        random_state=seed, shuffle=True,
    )
    train = df_target.iloc[train_idx]
    scaler = fit_scaler(train)
    Xtr = transform_features(train, scaler)
    ytr = train[target].to_numpy(dtype=float)

    templates = {model.name: model for model in models if model.monotonic}
    weight_map = {
        str(row.Base_Model): float(row.Meta_Weight)
        for row in split_weights.itertuples(index=False)
    }
    active_names = [
        name for name, weight in weight_map.items()
        if weight > CFG.STACKING_WEIGHT_TOL
    ]
    if not active_names:
        raise RuntimeError(f"No active stacking learner for {target} split {split_id}")

    fitted = {}
    required_names = list(dict.fromkeys(active_names + ["GA2M_Mono"]))
    for model_idx, name in enumerate(required_names, start=1):
        if name not in templates:
            raise RuntimeError(f"Saved stacking model {name} is unavailable")
        _progress_log(scope, f"base refit {model_idx}/{len(required_names)}: {name}")
        fitted_model = templates[name].clone()
        fitted_model.fit(Xtr, ytr, target=target)
        fitted[name] = fitted_model

    stack = WhiteBoxStackingWrapper(
        [templates[name] for name in active_names],
        inner_folds=CFG.INNER_CV_FOLDS,
        random_state=seed,
    )
    stack.base_model_names_ = active_names
    stack.fitted_base_models_ = [fitted[name] for name in active_names]
    stack.weights_ = np.asarray([weight_map[name] for name in active_names], dtype=float)
    stack.weights_ /= np.sum(stack.weights_)
    stack.intercept_ = float(split_weights["Meta_Intercept"].iloc[0])
    stack.is_fitted = True

    importance_tables = []
    shape_tables = []
    for fitted_model in (fitted["GA2M_Mono"], stack):
        importance = _get_native_main_effect_importance(fitted_model, Xtr)
        importance["Target"] = target
        importance["Model"] = fitted_model.name
        importance["Seed"] = seed
        importance["Fold"] = split_id
        importance_tables.append(importance)

        shapes = _compute_main_effect_table(fitted_model, Xtr, scaler, target)
        shapes["Model"] = fitted_model.name
        shapes["Seed"] = seed
        shapes["Fold"] = split_id
        shape_tables.append(shapes)
    result = {
        "importance": pd.concat(importance_tables, ignore_index=True),
        "shapes": pd.concat(shape_tables, ignore_index=True),
    }
    temporary_checkpoint = split_checkpoint + f".{os.getpid()}.tmp"
    joblib.dump(result, temporary_checkpoint, compress=3)
    os.replace(temporary_checkpoint, split_checkpoint)
    _progress_log(scope, f"completed and checkpointed: {split_checkpoint}")
    return result


def _recover_split_interpretations(df: pd.DataFrame,
                                   models: List[GAMModelWrapper],
                                   stacking_weights: pd.DataFrame) -> Dict[str, pd.DataFrame]:
    """Recover 10-split explanation tables from already saved stacking weights."""
    if stacking_weights.empty:
        raise RuntimeError("Saved stacking weights are required for automatic recovery")
    target_frames = {target: split_target(df, target) for target in TARGETS}
    tasks = [(target, seed) for seed in CFG.SPLIT_SEEDS for target in TARGETS]
    workers = min(CFG.OUTER_N_JOBS, len(tasks))
    _progress_log(
        "RECOVER",
        f"recovering split explanations with {workers} workers; OOF stacking is skipped",
    )
    recovered = joblib.Parallel(
        n_jobs=workers, backend="loky", verbose=CFG.JOBLIB_VERBOSE, max_nbytes="32M",
    )(
        joblib.delayed(_recover_one_split_interpretation)(
            target_frames[target], target, models, seed,
            stacking_weights[
                (stacking_weights["Target"] == target)
                & (stacking_weights["Seed"] == seed)
            ].copy(),
        )
        for target, seed in tasks
    )
    split_interpretations = {
        "importance": pd.concat(
            [item["importance"] for item in recovered], ignore_index=True
        ),
        "shapes": pd.concat(
            [item["shapes"] for item in recovered], ignore_index=True
        ),
    }
    joblib.dump(
        split_interpretations,
        os.path.join(_checkpoint_dir(), "split_interpretations_recovered.joblib"),
        compress=3,
    )
    return split_interpretations


def _resume_from_existing_results() -> None:
    """Automatically reuse completed numerical results and finish pending exports."""
    set_seed(CFG.RANDOM_STATE)
    _run_preflight_checks()
    df = load_and_prepare_data()
    models = get_available_models(include_monotonic=True)
    validation_checkpoint = os.path.join(
        _checkpoint_dir(), "validation_checkpoint.joblib"
    )
    if os.path.exists(validation_checkpoint):
        saved = joblib.load(validation_checkpoint)
        df_all = saved["df_all"]
        diagnostics = saved.get("stacking_diagnostics", pd.DataFrame())
        weights = saved.get("stacking_weights", pd.DataFrame())
        diversity = saved.get("stacking_diversity", pd.DataFrame())
        split_interpretations = saved.get("split_interpretations", {})
        _progress_log("RESUME", f"loaded validation checkpoint: {validation_checkpoint}")
    else:
        raw_path = os.path.join(CFG.OUTPUT_DIR, "cv_results_raw.xlsx")
        df_all = _load_excel_if_present(raw_path)
        if df_all.empty:
            raise RuntimeError(f"Completed validation file not found: {raw_path}")

        tables_dir = os.path.join(CFG.OUTPUT_DIR, "Results", "Tables")
        weights = _load_excel_if_present(
            os.path.join(tables_dir, "Stacking_weights.xlsx"), "Split_level"
        )
        diagnostics = _load_excel_if_present(
            os.path.join(tables_dir, "Stacking_meta_diagnostics.xlsx")
        )
        diversity = _load_excel_if_present(
            os.path.join(tables_dir, "Stacking_diversity.xlsx"), "Split_level"
        )
        recovered_path = os.path.join(
            _checkpoint_dir(), "split_interpretations_recovered.joblib"
        )
        if os.path.exists(recovered_path):
            split_interpretations = joblib.load(recovered_path)
            _progress_log("RESUME", "loaded recovered split-interpretation checkpoint")
        else:
            split_interpretations = _recover_split_interpretations(df, models, weights)

    if not split_interpretations or any(
        split_interpretations.get(name, pd.DataFrame()).empty
        for name in ("importance", "shapes")
    ):
        split_interpretations = _recover_split_interpretations(df, models, weights)
    df_agg = aggregate_results(df_all)
    _clean_manuscript_figure_dir(CFG.OUTPUT_DIR, purge=True)
    export_new_paper_result_workbooks(
        df_all, df_agg, diagnostics, weights, diversity, CFG.OUTPUT_DIR,
    )
    generate_manuscript_figures_v2(
        df, models, CFG.OUTPUT_DIR,
        split_interpretations=split_interpretations,
    )
    figure_dir = _verify_manuscript_figure_exports(CFG.OUTPUT_DIR)
    _mark_pipeline_complete()
    print(f"Automatic recovery complete. Figures: {figure_dir}", flush=True)

def _run_original_full_pipeline_then_figures() -> None:
    """Original numerical workflow, followed by the new manuscript figure exporter."""
    set_seed(CFG.RANDOM_STATE)
    _run_preflight_checks()
    ensure_dir(CFG.OUTPUT_DIR)
    print("=" * 60)
    print("Multi-GAM Model Comparison Study")
    print("(With and Without Monotonic Constraints)")
    print("=" * 60)
    print("\n[1] Loading data...")
    df = load_and_prepare_data()
    print("\n[2] Checking available models...")
    models = get_available_models(include_monotonic=True)
    if not models:
        print("ERROR: No models available.")
        return
    print(f"\n{len(models)} model variants available")
    print("\n[3] Running cross-validation...")
    (
        df_all,
        best_fold_preds_all,
        stacking_diagnostics_df,
        stacking_weights_df,
        stacking_diversity_df,
        split_interpretations,
        failed_tasks,
    ) = run_all_cv_comparisons(df, models)
    if df_all.empty:
        print("ERROR: No results.")
        return
    _save_validation_checkpoint(
        df_all, best_fold_preds_all, stacking_diagnostics_df,
        stacking_weights_df, stacking_diversity_df, split_interpretations,
    )

    for target in TARGETS:
        diagnostics_target = (
            stacking_diagnostics_df[stacking_diagnostics_df["Target"] == target]
            if not stacking_diagnostics_df.empty
            else pd.DataFrame()
        )
        diagnostics_target.to_excel(
            os.path.join(CFG.OUTPUT_DIR, f"{target}_stacking_meta_diagnostics.xlsx"),
            index=False,
        )
        if not stacking_weights_df.empty:
            weights_target = stacking_weights_df[stacking_weights_df["Target"] == target]
            weights_target.to_excel(
                os.path.join(CFG.OUTPUT_DIR, f"{target}_stacking_weights.xlsx"),
                index=False,
            )
        if not stacking_diversity_df.empty:
            diversity_target = stacking_diversity_df[
                stacking_diversity_df["Target"] == target
            ]
            diversity_target.to_excel(
                os.path.join(CFG.OUTPUT_DIR, f"{target}_stacking_diversity.xlsx"),
                index=False,
            )

    df_all.to_excel(os.path.join(CFG.OUTPUT_DIR, "cv_results_raw.xlsx"), index=False)
    if failed_tasks:
        pd.DataFrame([
            {
                "Target": item["target"],
                "Seed": item["seed"],
                "Error": item["error"],
            }
            for item in failed_tasks
        ]).to_excel(os.path.join(CFG.OUTPUT_DIR, "failed_outer_tasks.xlsx"), index=False)
    _progress_log("CHECKPOINT", f"raw split-level results saved to {CFG.OUTPUT_DIR}/cv_results_raw.xlsx")
    print("\n[4] Aggregating results...")
    df_agg = aggregate_results(df_all)
    df_agg.to_excel(os.path.join(CFG.OUTPUT_DIR, "cv_results_aggregated.xlsx"), index=False)
    print("\n[4.1] Exporting revised-paper result workbooks...")
    _clean_manuscript_figure_dir(CFG.OUTPUT_DIR, purge=True)
    export_new_paper_result_workbooks(
        df_all, df_agg, stacking_diagnostics_df, stacking_weights_df,
        stacking_diversity_df, CFG.OUTPUT_DIR
    )
    generate_comprehensive_fold_summary(df_all, CFG.OUTPUT_DIR)
    generate_manuscript_figures_v2(
        df, models, CFG.OUTPUT_DIR,
        split_interpretations=split_interpretations,
    )
    figure_dir = _verify_manuscript_figure_exports(CFG.OUTPUT_DIR)
    _mark_pipeline_complete()
    print("\n" + "=" * 60)
    print(f"Complete! Figures saved to: {figure_dir}")
    print("=" * 60)


def main() -> None:
    """Automatically resume prior results or start the full workflow when absent."""
    ensure_dir(CFG.OUTPUT_DIR)
    if _pipeline_exports_are_current():
        figure_dir = _verify_manuscript_figure_exports(CFG.OUTPUT_DIR)
        print(
            "Existing results are already marked complete. "
            f"No computation is required. Figures: {figure_dir}"
        )
    elif _has_reusable_validation_results():
        print("Existing numerical results detected; resuming automatically.")
        _resume_from_existing_results()
    else:
        print("No reusable numerical results detected; starting the full workflow.")
        _run_original_full_pipeline_then_figures()


if __name__ == "__main__":
    main()
