    }.get(name, name)


def _build_gams_stacking_deltas(df_all: pd.DataFrame,
                                stacking_weights: pd.DataFrame
                                ) -> Tuple[pd.DataFrame, pd.DataFrame]:
    """Build split-level deltas against GA2M-Mono and their uncertainty summary."""
    key_columns = ["Target", "Seed", "Fold"]
    ga = df_all[df_all["Model"] == "GA2M_Mono"][
        key_columns + ["Test_R2", "Test_PhysRate"]
    ].copy()
    ga = ga.rename(columns={
        "Test_R2": "GA2M_Test_R2",
        "Test_PhysRate": "GA2M_Test_PhysRate",
    })
    stack = df_all[df_all["Model"] == "WhiteBox_Stacking"][
        key_columns + ["Test_R2", "Test_PhysRate"]
    ].copy()
    stack = stack.rename(columns={
        "Test_R2": "GAMs_Mono_Stacking_Test_R2",
        "Test_PhysRate": "GAMs_Mono_Stacking_Test_PhysRate",
    })
    split_level = ga.merge(stack, on=key_columns, how="inner")
    split_level["Delta_Test_R2"] = (
        split_level["GAMs_Mono_Stacking_Test_R2"] - split_level["GA2M_Test_R2"]
    )
    split_level["Delta_Test_PhysRate"] = (
        split_level["GAMs_Mono_Stacking_Test_PhysRate"]
        - split_level["GA2M_Test_PhysRate"]
    )

    if stacking_weights is not None and not stacking_weights.empty:
        ga2m_oof = stacking_weights[
            stacking_weights["Base_Model"] == "GA2M_Mono"
        ][key_columns + ["Base_OOF_R2", "OOF_R2"]].drop_duplicates(key_columns)
        ga2m_oof = ga2m_oof.rename(columns={
            "Base_OOF_R2": "GA2M_OOF_R2",
            "OOF_R2": "GAMs_Mono_Stacking_OOF_R2",
        })
        split_level = split_level.merge(ga2m_oof, on=key_columns, how="left")
        split_level["Delta_OOF_R2"] = (
            split_level["GAMs_Mono_Stacking_OOF_R2"] - split_level["GA2M_OOF_R2"]
        )
    else:
        split_level["GA2M_OOF_R2"] = np.nan
        split_level["GAMs_Mono_Stacking_OOF_R2"] = np.nan
        split_level["Delta_OOF_R2"] = np.nan

    summary = (
        split_level.groupby("Target", as_index=False)
        .agg(
            Delta_Test_R2_Mean=("Delta_Test_R2", "mean"),
            Delta_Test_R2_SD=("Delta_Test_R2", "std"),
            Delta_OOF_R2_Mean=("Delta_OOF_R2", "mean"),
            Delta_OOF_R2_SD=("Delta_OOF_R2", "std"),
            Delta_Test_PhysRate_Mean=("Delta_Test_PhysRate", "mean"),
            Delta_Test_PhysRate_SD=("Delta_Test_PhysRate", "std"),
            Completed_Splits=("Fold", "count"),
        )
    )
    return split_level, summary


def _plot_fig4_delta_performance(delta_summary: pd.DataFrame,
                                 delta_split_level: pd.DataFrame,
                                 figures_dir: str,
                                 excel_dir: str) -> None:
    """Fig. 4: test and cross-validated R2 changes relative to GA2M-Mono."""
    if delta_summary.empty:
        return
    plot_df = delta_summary.set_index("Target").reindex(TARGETS).reset_index()
    x = np.arange(len(plot_df))
    fig, ax = plt.subplots(figsize=(7.4, 4.15))
    width = 0.34
    series = [
        (
            "Delta_Test_R2_Mean", "Delta_Test_R2_SD",
            r"Mean test $R^2$", SCI_ORANGE, -width / 2,
        ),
        (
            "Delta_OOF_R2_Mean", "Delta_OOF_R2_SD",
            r"Cross-validated $R^2$", SCI_BLUE, width / 2,
        ),
    ]
    for mean_col, sd_col, label, color, offset in series:
        values = plot_df[mean_col].to_numpy(dtype=float)
        errors = plot_df[sd_col].fillna(0.0).to_numpy(dtype=float)
        valid = np.isfinite(values)
        ax.bar(
            x[valid] + offset, values[valid], yerr=errors[valid],
            color=color, edgecolor=SCI_DARK, linewidth=0.55, width=width,
            label=label,
            error_kw={
                "ecolor": SCI_DARK, "elinewidth": 0.7,
                "capsize": 2.5, "capthick": 0.7,
            },
        )
        for idx in x[~valid]:
            ax.text(
                idx + offset, 0.0, "N/A", ha="center", va="bottom",
                fontsize=7.0, rotation=90,
            )
    ax.axhline(0, color=SCI_DARK, linewidth=0.85)
    ax.set_xticks(x)
    ax.set_xticklabels(
        [_target_display_name(target) for target in plot_df["Target"]],
        fontweight="bold",
    )
    ax.set_ylabel(r"Change in $R^2$")
    ax.set_title(
        r"GAMs-Mono-Stacking minus GA2M-Mono (10-split mean $\pm$ SD)",
        loc="left", fontsize=9.2, fontweight="bold",
    )
    ax.legend(
        frameon=False, ncol=2, loc="upper center",
        bbox_to_anchor=(0.5, 1.0), fontsize=8.0,
    )
    _style_panel(ax, grid=True)
    fig.tight_layout(pad=0.8)
    _save_figure_bundle(fig, figures_dir, "Fig4_delta_performance")
    plt.close(fig)

    summary_columns = [
        "Target", "Delta_Test_R2_Mean", "Delta_Test_R2_SD",
        "Delta_OOF_R2_Mean", "Delta_OOF_R2_SD", "Completed_Splits",
    ]
    split_columns = [
        "Target", "Seed", "Fold", "GA2M_Test_R2",
        "GAMs_Mono_Stacking_Test_R2", "Delta_Test_R2",
        "GA2M_OOF_R2", "GAMs_Mono_Stacking_OOF_R2", "Delta_OOF_R2",
    ]
    fig_summary = delta_summary[
        [column for column in summary_columns if column in delta_summary.columns]
    ].rename(columns={
        "Delta_OOF_R2_Mean": "Delta_CV_R2_Mean",
        "Delta_OOF_R2_SD": "Delta_CV_R2_SD",
    })
    fig_split_level = delta_split_level[
        [column for column in split_columns if column in delta_split_level.columns]
    ].rename(columns={
        "GA2M_OOF_R2": "GA2M_CV_R2",
        "GAMs_Mono_Stacking_OOF_R2": "GAMs_Mono_Stacking_CV_R2",
        "Delta_OOF_R2": "Delta_CV_R2",
    })
    with pd.ExcelWriter(os.path.join(excel_dir, "Fig4_delta_performance.xlsx")) as writer:
        fig_summary.to_excel(writer, sheet_name="Mean_SD", index=False)
        fig_split_level.to_excel(writer, sheet_name="Split_level", index=False)


def _format_average_best(average: float, best: float, decimals: int,
                         not_applicable: bool = False) -> str:
    if not_applicable or not np.isfinite(average) or not np.isfinite(best):
        return "N/A"
    return f"{average:.{decimals}f}/{best:.{decimals}f}"


def _build_gam_family_performance_table(
    df_gam: pd.DataFrame,
    model_order: List[str],
) -> Tuple[pd.DataFrame, pd.DataFrame]:
    """Create the manuscript's Average/Best Split GAM-family comparison table."""
    metric_specs = [
        ("Train R2 (Average/ Best Split)", "Train_R2", 4, False),
        ("Train RMSE (Average/ Best Split)", "Train_RMSE", 4, False),
        ("Train PhysRate (%, Average/ Best Split)", "Train_PhysRate", 2, True),
        ("Test R2 (Average/ Best Split)", "Test_R2", 4, False),
        ("Test RMSE (Average/ Best Split)", "Test_RMSE", 4, False),
        ("Test PhysRate (%, Average/ Best Split)", "Test_PhysRate", 2, True),
    ]
    display_rows = []
    numeric_rows = []
    for target in TARGETS:
        target_data = df_gam[df_gam["Target"] == target]
        for metric_idx, (metric_label, metric_column, decimals, is_physrate) in enumerate(metric_specs):
            display_row = {
                "Syngas component": target if metric_idx == 0 else "",
                "Statistical metrics": metric_label,
            }
            for model in model_order:
                model_data = target_data[target_data["Model"] == model]
                if model_data.empty:
                    display_row[_model_label_for_paper(model)] = "N/A"
                    continue
                best_idx = model_data["Test_R2"].idxmax()
                average = float(model_data[metric_column].mean())
                best = float(model_data.loc[best_idx, metric_column])
                not_applicable = is_physrate and target == "GY"
                display_row[_model_label_for_paper(model)] = _format_average_best(
                    average, best, decimals, not_applicable=not_applicable
                )
                numeric_rows.append({
                    "Target": target,
                    "Statistical_Metric": metric_label,
                    "Metric_Column": metric_column,
                    "Model": _model_label_for_paper(model),
                    "Average": np.nan if not_applicable else average,
                    "Best_Split_Value": np.nan if not_applicable else best,
                    "Best_Split": int(model_data.loc[best_idx, "Fold"]),
                    "Best_Seed": int(model_data.loc[best_idx, "Seed"]),
                })
            display_rows.append(display_row)
    return pd.DataFrame(display_rows), pd.DataFrame(numeric_rows)


