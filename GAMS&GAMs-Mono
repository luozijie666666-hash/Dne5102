    H = float(input("H [%%wt db]: "))
    O = float(input("O [%%wt db]: "))
    Ash = float(input("Ash [%%wt db]: "))
    MS = float(input("Moisture [%%wt]: "))
    Bed = int(input("Bed material [1-4]: "))
    print(f"Predicted {target}: {{predict(T, ER, SB, C, H, O, Ash, MS, Bed):.4f}}")
'''
    with open(os.path.join(script_dir, f"predict_{model_name}_{target}.py"), 'w', encoding='utf-8') as f:
        f.write(script_content)


def run_cv_comparison(df: pd.DataFrame, target: str, models: List[GAMModelWrapper], 
                     n_folds: int = 5) -> Tuple[pd.DataFrame, Dict[str, Dict]]:
    """Run CV comparison and return results DataFrame plus best-fold prediction data for scatter plots.
    
    Returns:
        df_results: DataFrame with per-fold metrics
        best_fold_preds: dict keyed by model_name, each value is a dict with keys:
            y_train, y_pred_train, y_test, y_pred_test, fold (best fold index, 1-based)
    """
    print(f"\n{'='*60}\nTarget: {target}\n{'='*60}")
    df_target = split_target(df, target)
    if len(df_target) < 50:
        print(f"Warning: Only {len(df_target)} samples")
        return pd.DataFrame(), {}
    
    kf = KFold(n_splits=n_folds, shuffle=True, random_state=CFG.RANDOM_STATE)
    results = []
    
    # Track best fold per model: {model_name: {"r2": best_r2, "data": {...}}}
    best_fold_tracker: Dict[str, Dict] = {}
    
    for fold_idx, (train_idx, test_idx) in enumerate(kf.split(df_target)):
        print(f"\n--- Fold {fold_idx + 1}/{n_folds} ---")
        df_train, df_test = df_target.iloc[train_idx], df_target.iloc[test_idx]
        scaler = fit_scaler(df_train)
        X_train, X_test = transform_features(df_train, scaler), transform_features(df_test, scaler)
        y_train, y_test = df_train[target].values, df_test[target].values
        
        for model in models:
            print(f"  {model.name}...", end=" ")
            try:
                model_fresh = model.clone()
                model_fresh.fit(X_train, y_train, target=target)
                
                # Test set metrics
                y_pred_test = model_fresh.predict(X_test)
                metrics_test = compute_metrics(y_test, y_pred_test)
                phys_rate_test, _ = check_physical_conformity(model_fresh, X_test, target)
                
                # Train set metrics
                y_pred_train = model_fresh.predict(X_train)
                metrics_train = compute_metrics(y_train, y_pred_train)
                phys_rate_train, _ = check_physical_conformity(model_fresh, X_train, target)
                
                # Track best fold by Test R²
                current_r2 = metrics_test['R2']
                if model.name not in best_fold_tracker or current_r2 > best_fold_tracker[model.name]["r2"]:
                    best_fold_tracker[model.name] = {
                        "r2": current_r2,
                        "fold": fold_idx + 1,
                        "y_train": y_train.copy(),
                        "y_pred_train": y_pred_train.copy(),
                        "y_test": y_test.copy(),
                        "y_pred_test": y_pred_test.copy(),
                    }
                
                # Combine all metrics
                metrics = {
                    "Model": model.name, 
                    "Target": target, 
                    "Fold": fold_idx + 1,
                    "FitTime": model_fresh.fit_time,
                    # Test metrics
                    "Test_RMSE": metrics_test['RMSE'],
                    "Test_R2": metrics_test['R2'],
                    "Test_MAE": metrics_test['MAE'],
                    "Test_MAPE": metrics_test['MAPE'],
                    "Test_PhysRate": phys_rate_test,
                    # Train metrics
                    "Train_RMSE": metrics_train['RMSE'],
                    "Train_R2": metrics_train['R2'],
                    "Train_MAE": metrics_train['MAE'],
                    "Train_MAPE": metrics_train['MAPE'],
                    "Train_PhysRate": phys_rate_train,
                    # Legacy columns for compatibility
                    "RMSE": metrics_test['RMSE'],
                    "R2": metrics_test['R2'],
                    "MAE": metrics_test['MAE'],
                    "MAPE": metrics_test['MAPE'],
                    "PhysRate": phys_rate_test,
                }
                print(f"Test: RMSE={metrics_test['RMSE']:.4f}, R2={metrics_test['R2']:.4f}, Phys={phys_rate_test:.1f}% | Train: R2={metrics_train['R2']:.4f}")
                results.append(metrics)
            except Exception as e:
                print(f"ERROR: {e}")
                results.append({"Model": model.name, "Target": target, "Fold": fold_idx + 1, 
                               "RMSE": np.nan, "MAE": np.nan, "R2": np.nan, "MAPE": np.nan, 
                               "FitTime": np.nan, "PhysRate": np.nan,
                               "Test_RMSE": np.nan, "Test_R2": np.nan, "Test_MAE": np.nan, 
                               "Test_MAPE": np.nan, "Test_PhysRate": np.nan,
                               "Train_RMSE": np.nan, "Train_R2": np.nan, "Train_MAE": np.nan,
                               "Train_MAPE": np.nan, "Train_PhysRate": np.nan})
    
    return pd.DataFrame(results), best_fold_tracker


def train_final_models(df: pd.DataFrame, target: str, models: List[GAMModelWrapper], 
                      save_dir: str,
                      best_fold_preds: Dict[str, Dict] = None) -> Dict[str, GAMModelWrapper]:
    """Train final models. Scatter plots use the best CV fold's data for each model.
    
    Args:
        df: full dataset
        target: target variable name
        models: list of model wrappers
        save_dir: directory to save outputs
        best_fold_preds: dict returned by run_cv_comparison, keyed by model_name,
            containing best-fold prediction arrays. If None or a model is missing,
            falls back to a fresh 80-20 split.
    """
    print(f"\n  Training final models for {target}...")
    df_target = split_target(df, target)
    
    # Prepare a fallback 80-20 split (used only if best_fold_preds is unavailable)
    n_train = int(len(df_target) * 0.8)
    indices = np.random.permutation(len(df_target))
    train_idx_fb, test_idx_fb = indices[:n_train], indices[n_train:]
    df_train_fb = df_target.iloc[train_idx_fb]
    df_test_fb  = df_target.iloc[test_idx_fb]
    scaler_fb   = fit_scaler(df_train_fb)
    X_train_fb  = transform_features(df_train_fb, scaler_fb)
    X_test_fb   = transform_features(df_test_fb,  scaler_fb)
    y_train_fb  = df_train_fb[target].values
    y_test_fb   = df_test_fb[target].values
    
    trained = {}
    
    for model in models:
        print(f"    {model.name}...", end=" ")
        try:
            # ---- Determine which data to use for scatter plot ----
            if best_fold_preds and model.name in best_fold_preds:
                bp = best_fold_preds[model.name]
                y_train_sc     = bp["y_train"]
                y_pred_train_sc = bp["y_pred_train"]
                y_test_sc      = bp["y_test"]
                y_pred_test_sc = bp["y_pred_test"]
                best_fold_num  = bp["fold"]
                scatter_note   = f"best CV fold ({best_fold_num})"
            else:
                # Fallback: train a fresh model on the 80-20 split
                model_temp = model.clone()
                model_temp.fit(X_train_fb, y_train_fb, target=target)
                y_train_sc      = y_train_fb
                y_pred_train_sc = model_temp.predict(X_train_fb)
                y_test_sc       = y_test_fb
                y_pred_test_sc  = model_temp.predict(X_test_fb)
                scatter_note    = "80-20 split (fallback)"
            
            print(f"[scatter: {scatter_note}]", end=" ")
            
            # ---- Train a full-data model for saving / feature importance / shape fns ----
            # Use the full 80-20 fallback split for saving (same as before)
            model_fresh = model.clone()
            model_fresh.fit(X_train_fb, y_train_fb, target=target)
            
            trained[model.name] = model_fresh
            save_model_and_scaler(model_fresh, scaler_fb, target, save_dir)
            generate_prediction_script(model.name, target, save_dir)
            plot_feature_importance(model_fresh, save_dir, target)
            
            # Plot scatter using best-fold (or fallback) data
            _fold_label = f"(Best CV Fold {best_fold_num})" if (best_fold_preds and model.name in best_fold_preds) else "(80-20 split)"
            plot_prediction_scatter_train_test(y_train_sc, y_pred_train_sc,
                                               y_test_sc,  y_pred_test_sc,
                                               model.name, target, save_dir,
                                               fold_label=_fold_label)
            plot_residuals(y_test_sc, y_pred_test_sc, model.name, target, save_dir)
            print("OK")
        except Exception as e:
            print(f"ERROR: {e}")
    
    return trained


def aggregate_results(df_results: pd.DataFrame) -> pd.DataFrame:
    agg = df_results.groupby(["Target", "Model"]).agg({
        "RMSE": ["mean", "std"], "MAE": ["mean", "std"], "R2": ["mean", "std"],
        "MAPE": ["mean", "std"], "PhysRate": ["mean", "std"], "FitTime": ["mean"],
    }).round(4)
    agg.columns = ["_".join(col).strip() for col in agg.columns.values]
    return agg.reset_index()


