                transform=axes[0].transAxes, ha="center", va="center",
                fontsize=8.2, color=SCI_GRAY,
            )
            cax.axis("off")
            panel_idx += n_cols
            continue

        target_vlim = max(
            max(float(np.nanmax(np.abs(np.asarray(record["Z"], dtype=float)))), 1e-9)
            for record in records
        )
        row_mappable = None
        rows = []

        for col_idx, ax in enumerate(axes):
            if col_idx >= len(records):
                ax.axis("off")
                panel_idx += 1
                continue

            record = records[col_idx]
            row_mappable = _draw_isolated_interaction_panel(
                ax, record, target, f"({_panel_letter(panel_idx)})",
                vlim=target_vlim,
            )
            for iy, y_value in enumerate(record["y_original"]):
                for ix, x_value in enumerate(record["x_original"]):
                    rows.append({
                        "Target": target,
                        "Rank": int(record["rank"]),
                        "Term": _format_term_name((record["feature_i"], record["feature_j"])),
                        "X_Feature": record["feature_i_name"],
                        "Y_Feature": record["feature_j_name"],
                        "X": float(x_value),
                        "Y": float(y_value),
                        "PairwiseContribution": float(record["Z"][iy, ix]),
                        "SelectionType": record.get("selection_type", "Continuous-continuous retained term"),
                    })
            panel_idx += 1

        if rows:
            export_sheets[target] = pd.DataFrame(rows)
        if row_mappable is not None:
            cbar = fig.colorbar(row_mappable, cax=cax)
            cbar.set_label(
                f"{target} pairwise contribution\n[vol% N$_2$ free]",
                fontsize=7.3, labelpad=4,
            )
            cbar.ax.tick_params(labelsize=6.7, direction="in", pad=2)
            cbar.outline.set_linewidth(0.65)
        else:
            cax.axis("off")

    _save_figure_bundle(fig, manuscript_dir, "Fig2_interaction_surface")
    plt.close(fig)

    with pd.ExcelWriter(
        os.path.join(manuscript_dir, "Fig2_interaction_surface.xlsx")
    ) as writer:
        for target in INTERPRETATION_TARGETS:
            if target in export_sheets:
                export_sheets[target].to_excel(
                    writer,
                    sheet_name=target,
                    index=False,
                )
            ranking = pair_rankings.get(target)
            if ranking is not None and not ranking.empty:
                ranking_export = ranking.copy()
                ranking_export["FeatureIndices"] = ranking_export["FeatureIndices"].apply(
                    lambda value: ",".join(map(str, value))
                    if isinstance(value, (tuple, list, np.ndarray)) else ""
                )
                ranking_export.to_excel(
                    writer,
                    sheet_name=(target + "_ranking")[:31],
