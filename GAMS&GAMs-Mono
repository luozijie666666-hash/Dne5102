                if split_shape_tables else pd.DataFrame()
            ),
            "error": f"{type(exc).__name__}: {exc}",
        }


def _merge_outer_outcomes(outcomes: List[Dict[str, Any]], targets: List[str]):
    rows = []
    best_all: Dict[str, Dict[str, Dict[str, Any]]] = {target: {} for target in targets}
    selected_rows = []
    weight_tables = []
    diversity_tables = []
    split_importance_tables = []
    split_shape_tables = []
    failed_tasks = []

    for outcome in outcomes:
        target = outcome["target"]
        rows.extend(outcome.get("results", []))
        if outcome.get("selected") is not None:
            selected_rows.append(outcome["selected"])
        weights = outcome.get("weights")
        if isinstance(weights, pd.DataFrame) and not weights.empty:
            weight_tables.append(weights)
        diversity = outcome.get("diversity")
        if isinstance(diversity, pd.DataFrame) and not diversity.empty:
            diversity_tables.append(diversity)
        split_importance = outcome.get("split_importance")
        if isinstance(split_importance, pd.DataFrame) and not split_importance.empty:
            split_importance_tables.append(split_importance)
        split_shapes = outcome.get("split_shapes")
        if isinstance(split_shapes, pd.DataFrame) and not split_shapes.empty:
            split_shape_tables.append(split_shapes)
        if outcome.get("error"):
            failed_tasks.append(outcome)
        for model_name, candidate in outcome.get("best", {}).items():
            current = best_all[target].get(model_name)
            if current is None or candidate["r2"] > current["r2"]:
                best_all[target][model_name] = candidate

    selection_df = pd.DataFrame(selected_rows)
    weights_df = pd.concat(weight_tables, ignore_index=True) if weight_tables else pd.DataFrame()
    diversity_df = (
        pd.concat(diversity_tables, ignore_index=True)
        if diversity_tables else pd.DataFrame()
    )
    interpretation_tables = {
        "importance": (
            pd.concat(split_importance_tables, ignore_index=True)
            if split_importance_tables else pd.DataFrame()
        ),
        "shapes": (
            pd.concat(split_shape_tables, ignore_index=True)
            if split_shape_tables else pd.DataFrame()
        ),
    }
    selection_df.attrs["stacking_weights"] = weights_df
    selection_df.attrs["stacking_diversity"] = diversity_df
    selection_df.attrs["split_interpretations"] = interpretation_tables
    return (
        pd.DataFrame(rows), best_all, selection_df, weights_df, diversity_df,
        interpretation_tables, failed_tasks,
    )


def summarize_best_splits(df_results: pd.DataFrame) -> pd.DataFrame:
    """Return the highest-Test-R2 split for every target-model combination."""
    if df_results.empty:
        return pd.DataFrame()
    valid = df_results[np.isfinite(df_results["Test_R2"])].copy()
    if valid.empty:
        return pd.DataFrame()

    best_indices = valid.groupby(["Target", "Model"])["Test_R2"].idxmax()
    best = valid.loc[best_indices].copy()
    mean_stats = (
        valid.groupby(["Target", "Model"], as_index=False)
        .agg(
            Mean_Test_R2=("Test_R2", "mean"),
            SD_Test_R2=("Test_R2", "std"),
            Completed_Splits=("Fold", "count"),
        )
    )
    best = best.merge(mean_stats, on=["Target", "Model"], how="left")
    best = best.rename(columns={
        "Seed": "Best_Seed",
        "Fold": "Best_Split",
        "Train_R2": "Best_Train_R2",
        "Train_RMSE": "Best_Train_RMSE",
        "Train_MAE": "Best_Train_MAE",
        "Train_PhysRate": "Best_Train_PhysRate",
        "Test_R2": "Best_Test_R2",
        "Test_RMSE": "Best_Test_RMSE",
        "Test_MAE": "Best_Test_MAE",
        "Test_MAPE": "Best_Test_MAPE",
        "Test_PhysRate": "Best_Test_PhysRate",
        "FitTime": "Best_FitTime",
    })
    columns = [
        "Target", "Model", "Mean_Test_R2", "SD_Test_R2",
        "Best_Test_R2", "Best_Seed", "Best_Split",
        "Best_Test_RMSE", "Best_Test_MAE", "Best_Test_MAPE",
        "Best_Test_PhysRate", "Best_Train_R2", "Best_Train_RMSE",
        "Best_Train_MAE", "Best_Train_PhysRate", "Best_FitTime",
        "Completed_Splits",
    ]
    columns = [column for column in columns if column in best.columns]
    target_rank = {name: idx for idx, name in enumerate(TARGETS)}
    best["__target_rank"] = best["Target"].map(target_rank).fillna(len(target_rank))
    best = best.sort_values(
        ["__target_rank", "Mean_Test_R2"], ascending=[True, False]
    ).drop(columns="__target_rank")
    return best[columns].reset_index(drop=True)


def _print_cv_result_summary(df_results: pd.DataFrame) -> None:
    """Print mean and best-split test results after parallel validation."""
    if df_results.empty:
        return
    best_summary = summarize_best_splits(df_results)
    mean_extra = (
        df_results.groupby(["Target", "Model"], as_index=False)
        .agg(
            Mean_Test_RMSE=("Test_RMSE", "mean"),
            Mean_Test_PhysRate=("Test_PhysRate", "mean"),
        )
    )
    summary = best_summary.merge(mean_extra, on=["Target", "Model"], how="left")
    _progress_log("SUMMARY", "mean and best-split outer-test results")
    for target in TARGETS:
        sub = summary[summary["Target"] == target].sort_values("Mean_Test_R2", ascending=False)
        if sub.empty:
            continue
        _progress_log("SUMMARY", f"--- {target} ---")
        for row in sub.itertuples(index=False):
            _progress_log(
                "SUMMARY",
                f"{row.Model:<20} Mean R2={row.Mean_Test_R2:.4f} +/- {row.SD_Test_R2:.4f}; "
                f"Best-split R2={row.Best_Test_R2:.4f} "
                f"(split={int(row.Best_Split)}, seed={int(row.Best_Seed)}); "
                f"Mean RMSE={row.Mean_Test_RMSE:.4f}, "
                f"Mean PhysRate={_format_physrate(row.Mean_Test_PhysRate)}, "
                f"splits={int(row.Completed_Splits)}/{len(CFG.SPLIT_SEEDS)}",
            )


def run_all_cv_comparisons(df: pd.DataFrame, models: List[GAMModelWrapper]):
    """Run every target/split validation task in one process-level parallel queue."""
    target_frames = {target: split_target(df, target) for target in TARGETS}
    tasks = [(target, seed) for seed in CFG.SPLIT_SEEDS for target in TARGETS]
    workers = min(CFG.OUTER_N_JOBS, len(tasks))
    _progress_log(
        "PARALLEL",
        f"CPU budget={CFG.CPU_BUDGET}; outer workers={workers}; "
        f"threads/model={CFG.MODEL_N_JOBS}; total tasks={len(tasks)}",
    )
    if CFG.CPU_BUDGET == 1:
        _progress_log(
            "PARALLEL",
            "WARNING: only one CPU is allocated/detected; request 128 CPUs from the "
            "scheduler or set GAM_CPU_BUDGET=128 after confirming the allocation",
        )
    outcomes = joblib.Parallel(
        n_jobs=workers,
        backend="loky",
        verbose=CFG.JOBLIB_VERBOSE,
        max_nbytes="32M",
    )(
        joblib.delayed(_run_single_outer_split)(target_frames[target], target, models, seed)
        for target, seed in tasks
    )
    merged = _merge_outer_outcomes(outcomes, TARGETS)
    _print_cv_result_summary(merged[0])
    if merged[6]:
        _progress_log("PARALLEL", f"warning: {len(merged[6])}/{len(tasks)} outer tasks failed")
    return merged


def run_cv_comparison(df: pd.DataFrame, target: str, models: List[GAMModelWrapper],
                      n_folds: int = 10) -> Tuple[pd.DataFrame, Dict, pd.DataFrame]:
    """Compatibility entry point for running all outer splits of one target."""
    df_target = split_target(df, target)
    workers = min(CFG.OUTER_N_JOBS, len(CFG.SPLIT_SEEDS))
    outcomes = joblib.Parallel(
        n_jobs=workers,
        backend="loky",
        verbose=CFG.JOBLIB_VERBOSE,
        max_nbytes="32M",
    )(
        joblib.delayed(_run_single_outer_split)(df_target, target, models, seed)
        for seed in CFG.SPLIT_SEEDS
    )
    (
        df_results, best_all, selected_df, weights_df, diversity_df,
        interpretation_tables, _,
    ) = _merge_outer_outcomes(outcomes, [target])
    selected_df.attrs["stacking_weights"] = weights_df
    selected_df.attrs["stacking_diversity"] = diversity_df
    selected_df.attrs["split_interpretations"] = interpretation_tables
    _print_cv_result_summary(df_results)
    return df_results, best_all[target], selected_df


def aggregate_results(df_results: pd.DataFrame) -> pd.DataFrame:
    agg = df_results.groupby(["Target", "Model"]).agg({
        "RMSE": ["mean", "std"], "MAE": ["mean", "std"], "R2": ["mean", "std"],
        "MAPE": ["mean", "std"], "PhysRate": ["mean", "std"], "FitTime": ["mean"],
    }).round(4)
    agg.columns = ["_".join(col).strip() for col in agg.columns.values]
    return agg.reset_index()




def generate_comprehensive_fold_summary(df_all: pd.DataFrame, save_dir: str) -> None:
    """
    Generate a comprehensive summary table with Train/Test metrics for each model, 
    target, and fold. Exports to Excel with multiple sheets.
    """
    ensure_dir(save_dir)
    
    # Define columns for the summary
    summary_cols = [
        "Model", "Target", "Fold",
        "Train_R2", "Train_RMSE", "Train_PhysRate",
        "Test_R2", "Test_RMSE", "Test_PhysRate",
        "FitTime"
    ]
    
    # Filter available columns
    available_cols = [c for c in summary_cols if c in df_all.columns]
    df_summary = df_all[available_cols].copy()
    
    # Round numeric columns
    numeric_cols = ["Train_R2", "Train_RMSE", "Train_PhysRate", "Test_R2", "Test_RMSE", "Test_PhysRate", "FitTime"]
    for col in numeric_cols:
        if col in df_summary.columns:
            df_summary[col] = df_summary[col].round(4)
    
    # Save comprehensive summary
    summary_path = os.path.join(save_dir, "comprehensive_fold_summary.xlsx")
    
    with pd.ExcelWriter(summary_path, engine="openpyxl") as writer:
