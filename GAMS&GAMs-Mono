def _refit_ga2m_and_stacking_for_interpretation(df, models, target):
    """Refit GA2M-Mono and the four-model white-box ensemble on all data."""
    data = split_target(df, target)
    scaler = fit_scaler(data)
    X = transform_features(data, scaler)
    y = data[target].to_numpy(dtype=float)
    ga2m = next((m for m in models if m.name == "GA2M_Mono"), None)
    if ga2m is None:
        raise RuntimeError("GA2M_Mono unavailable")
    ga2m = ga2m.clone()
    ga2m.fit(X, y, target=target)
    mono_library = [model for model in models if model.monotonic]
    if len(mono_library) != 4:
        raise RuntimeError("Four monotonic GAM-family models are required for stacking")
    stack = WhiteBoxStackingWrapper(
        mono_library,
        inner_folds=CFG.INNER_CV_FOLDS,
        random_state=CFG.RANDOM_STATE,
    )
    stack.fit(X, y, target=target)
    return data, scaler, X, ga2m, stack

def generate_manuscript_figures_v2(df: pd.DataFrame,
                                   models: List[GAMModelWrapper],
                                   output_dir: str,
