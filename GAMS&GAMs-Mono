                ax.set_xlabel(f"Measured {TARGET_UNITS.get(target, target)}", fontsize=8.2)
            else:
                ax.set_xlabel("")
            r2_test = r2_score(df_test["Actual"], df_test["Predicted"]) if len(df_test) > 1 else np.nan
