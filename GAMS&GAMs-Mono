class NAMWrapper(GAMModelWrapper):
    def __init__(self, monotonic: bool = False, hidden_units: List[int] = None,
                 epochs: int = 200, lr: float = 0.01,
                 random_state: int = CFG.RANDOM_STATE):
        super().__init__(name="NAM_Mono" if monotonic else "NAM", monotonic=monotonic)
        self.hidden_units = hidden_units or [64, 32]
        self.epochs = epochs
        self.lr = lr
        self.random_state = int(random_state)
        self._feature_nns = None
        self._bias = None
        self._device = None
        self._constraints = None
        self._X_train = None
        self._isotonic_models = None
    
    def _build_model(self, target: str = None) -> Any:
        self._constraints = (
            get_constraints_vector(target)
            if self.monotonic and target
            else [0] * len(FEATURE_COLUMNS)
        )
        return self

    def _reset_training_seed(self, torch_module) -> None:
        """Reset all RNGs so paired NAM/NAM-Mono fits share initialization."""
        random.seed(self.random_state)
        np.random.seed(self.random_state)
        torch_module.manual_seed(self.random_state)
        if torch_module.cuda.is_available():
            torch_module.cuda.manual_seed_all(self.random_state)
            # Required by some CUDA versions for deterministic matrix products.
            os.environ.setdefault("CUBLAS_WORKSPACE_CONFIG", ":4096:8")
        try:
            torch_module.use_deterministic_algorithms(True, warn_only=True)
        except TypeError:
            # Compatibility with older PyTorch releases without warn_only.
            try:
                torch_module.use_deterministic_algorithms(True)
            except Exception:
                pass
        except Exception:
            pass
        if hasattr(torch_module.backends, "cudnn"):
            torch_module.backends.cudnn.deterministic = True
            torch_module.backends.cudnn.benchmark = False
    
    def fit(self, X: np.ndarray, y: np.ndarray, target: str = None) -> 'NAMWrapper':
        import torch
        import torch.nn as nn

        self.target = target
        start = time.time()
        torch.set_num_threads(CFG.MODEL_N_JOBS)
        try:
            torch.set_num_interop_threads(1)
        except RuntimeError:
            # PyTorch only permits setting inter-op threads before parallel work starts.
            pass
        self._reset_training_seed(torch)
        self._constraints = (
            get_constraints_vector(target)
            if self.monotonic and target
            else [0] * len(FEATURE_COLUMNS)
        )
        self._isotonic_models = None
        self._device = torch.device("cpu")
        self._X_train = X.copy()
        X_t = torch.tensor(X, dtype=torch.float32, device=self._device)
        y_t = torch.tensor(y, dtype=torch.float32, device=self._device).reshape(-1, 1)
        self._feature_nns = nn.ModuleList()
        for i in range(X.shape[1]):
            layers = []
            in_dim = 1
            for h in self.hidden_units:
                layers.append(nn.Linear(in_dim, h))
                layers.append(nn.ReLU())
                in_dim = h
            layers.append(nn.Linear(in_dim, 1))
            self._feature_nns.append(nn.Sequential(*layers).to(self._device))
        self._bias = nn.Parameter(torch.zeros(1, device=self._device))
        params = list(self._feature_nns.parameters()) + [self._bias]
        optimizer = torch.optim.Adam(params, lr=self.lr)
        loss_fn = nn.MSELoss()
        for _ in range(self.epochs):
            optimizer.zero_grad()
            pred = self._bias.clone()
            for i, nn_i in enumerate(self._feature_nns):
                pred = pred + nn_i(X_t[:, i:i+1])
            loss = loss_fn(pred, y_t)
            loss.backward()
            optimizer.step()

        has_active_constraints = any(
            value != 0 for value in self._constraints[:N_CONTINUOUS]
        )
        if self.monotonic and has_active_constraints:
            self._build_isotonic_models(X)

        self.model = self
        self.fit_time = time.time() - start
        self.is_fitted = True
        return self
    
    def _build_isotonic_models(self, X: np.ndarray):
        from sklearn.isotonic import IsotonicRegression
        from scipy.interpolate import interp1d
        import torch
        self._isotonic_models = {}
        for i in range(N_CONTINUOUS):
            if self._constraints[i] == 0:
                continue
            x_vals = np.linspace(X[:, i].min(), X[:, i].max(), 200)
            with torch.no_grad():
                x_t = torch.tensor(x_vals.reshape(-1, 1), dtype=torch.float32, device=self._device)
                y_vals = self._feature_nns[i](x_t).cpu().numpy().flatten()
            sort_idx = np.argsort(x_vals)
            x_sorted, y_sorted = x_vals[sort_idx], y_vals[sort_idx]
            increasing = self._constraints[i] > 0
            ir = IsotonicRegression(increasing=increasing, out_of_bounds='clip')
            y_mono = ir.fit_transform(x_sorted, y_sorted)
            self._isotonic_models[i] = {
                'original': interp1d(x_sorted, y_sorted, kind='linear', bounds_error=False, fill_value=(y_sorted[0], y_sorted[-1])),
                'monotonic': interp1d(x_sorted, y_mono, kind='linear', bounds_error=False, fill_value=(y_mono[0], y_mono[-1])),
            }
    
    def predict(self, X: np.ndarray) -> np.ndarray:
        import torch
        X_t = torch.tensor(X, dtype=torch.float32, device=self._device)
        with torch.no_grad():
            pred = self._bias.clone().cpu().numpy().flatten()[0]
            pred = np.full(X.shape[0], pred)
            for i, nn_i in enumerate(self._feature_nns):
                f_vals = nn_i(X_t[:, i:i+1]).cpu().numpy().flatten()
                if self.monotonic and self._isotonic_models and i in self._isotonic_models:
                    mono_vals = self._isotonic_models[i]['monotonic'](X[:, i])
                    pred += mono_vals
                else:
                    pred += f_vals
        return pred
    
    def clone(self) -> 'NAMWrapper':
        return NAMWrapper(
            monotonic=self.monotonic,
            hidden_units=list(self.hidden_units),
            epochs=self.epochs,
            lr=self.lr,
            random_state=self.random_state,
        )



class WhiteBoxStackingWrapper(GAMModelWrapper):
    """OOF-trained simplex ensemble of all monotonic GAM-family learners."""

    def __init__(self, base_models: List[GAMModelWrapper], inner_folds: int = None,
                 random_state: int = None):
        super().__init__(name="WhiteBox_Stacking", monotonic=True)
        self.base_model_templates = [m.clone() for m in base_models]
        self.inner_folds = inner_folds or CFG.INNER_CV_FOLDS
        self.random_state = CFG.RANDOM_STATE if random_state is None else random_state
        self.fitted_base_models_: List[GAMModelWrapper] = []
        self.base_model_names_: List[str] = [m.name for m in self.base_model_templates]
        self.weights_ = None
        self.intercept_ = 0.0
        self.oof_predictions_ = None
        self.oof_fold_ids_ = None
        self.oof_r2_ = np.nan
        self.base_oof_r2_: Dict[str, float] = {}
        self.best_base_oof_r2_ = np.nan
        self.oof_gain_ = np.nan
        self.meta_lambda_ = np.nan
        self.meta_cv_mse_ = np.nan
        self.meta_cv_results_: List[Dict[str, float]] = []
        self.meta_strategy_ = "simplex_constrained_ridge"

    def _build_model(self, target: str = None) -> 'WhiteBoxStackingWrapper':
        """Satisfy the wrapper interface; stacking owns its complete fit routine."""
        self.target = target
        return self

    @staticmethod
    def _fit_simplex_ridge(P: np.ndarray, y: np.ndarray, ridge_lambda: float):
        """Fit nonnegative sum-to-one weights with a free intercept."""
        P = np.asarray(P, dtype=float)
        y = np.asarray(y, dtype=float)
        n_models = P.shape[1]
        P_centered = P - np.mean(P, axis=0, keepdims=True)
        y_centered = y - np.mean(y)

        def objective(weights):
            residual = y_centered - P_centered @ weights
            return float(np.mean(residual ** 2) + ridge_lambda * np.sum(weights ** 2))

        def gradient(weights):
            residual = y_centered - P_centered @ weights
            return (
                -2.0 * (P_centered.T @ residual) / len(y_centered)
                + 2.0 * ridge_lambda * weights
            )

        result = minimize(
            objective,
            x0=np.full(n_models, 1.0 / n_models, dtype=float),
            jac=gradient,
            method="SLSQP",
            bounds=[(0.0, 1.0)] * n_models,
            constraints={
                "type": "eq",
                "fun": lambda weights: float(np.sum(weights) - 1.0),
                "jac": lambda weights: np.ones_like(weights),
            },
            options={"ftol": 1e-12, "maxiter": 1000, "disp": False},
        )
        if not result.success:
            raise RuntimeError(f"Simplex meta-learner optimization failed: {result.message}")
        weights = np.clip(np.asarray(result.x, dtype=float), 0.0, 1.0)
        weight_sum = float(np.sum(weights))
        if weight_sum <= 0:
            raise RuntimeError("Simplex meta-learner returned zero total weight")
        weights /= weight_sum
        intercept = float(np.mean(y - P @ weights))
        return weights, intercept

    @classmethod
    def _select_meta_lambda(cls, P: np.ndarray, y: np.ndarray,
                            fold_ids: np.ndarray):
        """Select ridge strength by cross-fitting within the outer-training data."""
        records = []
        for ridge_lambda in CFG.STACKING_META_LAMBDAS:
            meta_cv_pred = np.full(len(y), np.nan, dtype=float)
            for fold_id in np.unique(fold_ids):
                validation = fold_ids == fold_id
                training = ~validation
                weights, intercept = cls._fit_simplex_ridge(
                    P[training], y[training], float(ridge_lambda)
                )
                meta_cv_pred[validation] = intercept + P[validation] @ weights
            mse = float(mean_squared_error(y, meta_cv_pred))
            records.append({"Meta_Lambda": float(ridge_lambda), "Meta_CV_MSE": mse})
        best = min(records, key=lambda row: (row["Meta_CV_MSE"], row["Meta_Lambda"]))
        return best["Meta_Lambda"], best["Meta_CV_MSE"], records

    def fit(self, X, y, target=None):
        start = time.time()
        self.target = target
        X = np.asarray(X)
        y = np.asarray(y, dtype=float)
        n_samples = X.shape[0]
        n_models = len(self.base_model_templates)
        if n_models != 4 or not all(model.monotonic for model in self.base_model_templates):
            raise ValueError(
                "WhiteBoxStackingWrapper requires all four monotonic GAM-family models"
            )
        if len(set(self.base_model_names_)) != n_models:
            raise ValueError("Stacking base model names must be unique")

        oof = np.full((n_samples, n_models), np.nan, dtype=float)
        oof_fold_ids = np.full(n_samples, -1, dtype=int)
        kf = KFold(n_splits=self.inner_folds, shuffle=True, random_state=self.random_state)
        scope = f"{target} stacking seed {self.random_state}"
        for fold_id, (tr_idx, va_idx) in enumerate(kf.split(X), start=1):
            _progress_log(
                scope,
                f"OOF fold {fold_id}/{self.inner_folds}: fitting {n_models} monotonic learners",
            )
            oof_fold_ids[va_idx] = fold_id - 1
            for model_idx, template in enumerate(self.base_model_templates):
                m = template.clone()
                m.fit(X[tr_idx], y[tr_idx], target=target)
                oof[va_idx, model_idx] = m.predict(X[va_idx])
            _progress_log(scope, f"OOF fold {fold_id}/{self.inner_folds}: completed")

        if np.isnan(oof).any():
            raise RuntimeError("OOF stacking matrix contains missing predictions")

        self.meta_lambda_, self.meta_cv_mse_, self.meta_cv_results_ = self._select_meta_lambda(
            oof, y, oof_fold_ids
        )
        self.weights_, self.intercept_ = self._fit_simplex_ridge(
            oof, y, self.meta_lambda_
        )
        if (
            np.any(self.weights_ < -CFG.STACKING_WEIGHT_TOL)
            or not np.isclose(np.sum(self.weights_), 1.0, atol=CFG.STACKING_WEIGHT_TOL)
        ):
            raise RuntimeError("Stacking weights must be nonnegative and sum to one")
        self.oof_predictions_ = oof
        self.oof_fold_ids_ = oof_fold_ids
        self.oof_r2_ = float(r2_score(y, self.intercept_ + oof @ self.weights_))
        self.base_oof_r2_ = {
            name: float(r2_score(y, oof[:, model_idx]))
            for model_idx, name in enumerate(self.base_model_names_)
        }
        self.best_base_oof_r2_ = max(self.base_oof_r2_.values())
        self.oof_gain_ = self.oof_r2_ - self.best_base_oof_r2_
        _progress_log(
            scope,
            f"meta learner selected lambda={self.meta_lambda_:g}; "
            f"cross-fitted MSE={self.meta_cv_mse_:.4f}",
        )

        self.fitted_base_models_ = []
        for model_idx, template in enumerate(self.base_model_templates, start=1):
            _progress_log(scope, f"full refit {model_idx}/{n_models}: {template.name}")
            m = template.clone()
            m.fit(X, y, target=target)
            self.fitted_base_models_.append(m)

        self.fit_time = time.time() - start
        self.is_fitted = True
        return self

    def predict(self, X):
        if not self.fitted_base_models_:
            raise RuntimeError("WhiteBox_Stacking must be fitted before prediction")
        P = np.column_stack([m.predict(X) for m in self.fitted_base_models_])
        return self.intercept_ + P @ self.weights_

    def clone(self):
        return WhiteBoxStackingWrapper(
            self.base_model_templates,
            inner_folds=self.inner_folds,
            random_state=self.random_state,
        )

    def get_feature_importance(self):
        if self.weights_ is None or not self.fitted_base_models_:
            return {}
        out: Dict[str, float] = {}
        for weight, model in zip(self.weights_, self.fitted_base_models_):
            importance = model.get_feature_importance()
            for key, value in importance.items():
                out[key] = out.get(key, 0.0) + float(weight) * abs(float(value))
        total = sum(out.values())
        if total > 0:
            out = {key: value / total for key, value in out.items()}
        return out

    def get_weight_table(self, target: str = None, seed: int = None, fold: int = None) -> pd.DataFrame:
        rows = []
        weights = self.weights_ if self.weights_ is not None else np.zeros(len(self.base_model_names_))
        for name, weight in zip(self.base_model_names_, weights):
            rows.append({
                "Target": target if target is not None else self.target,
                "Seed": seed,
                "Fold": fold,
                "Base_Model": name,
                "Meta_Weight": float(weight),
                "Weight_Share": float(weight),
                "Meta_Intercept": float(self.intercept_),
                "Meta_Lambda": float(self.meta_lambda_),
                "Meta_CV_MSE": float(self.meta_cv_mse_),
                "Meta_Strategy": self.meta_strategy_,
                "Base_OOF_R2": self.base_oof_r2_.get(name, np.nan),
                "OOF_R2": self.oof_r2_,
                "Best_Base_OOF_R2": self.best_base_oof_r2_,
                "OOF_Gain": self.oof_gain_,
            })
        return pd.DataFrame(rows)

    def get_diversity_table(self, target: str = None, seed: int = None,
                            fold: int = None, y=None) -> pd.DataFrame:
        """Quantify pairwise OOF error complementarity among base learners."""
        if self.oof_predictions_ is None or y is None:
            return pd.DataFrame()
        y = np.asarray(y, dtype=float)
        rows = []
        for left in range(len(self.base_model_names_)):
            for right in range(left + 1, len(self.base_model_names_)):
                error_left = y - self.oof_predictions_[:, left]
                error_right = y - self.oof_predictions_[:, right]
                correlation = float(np.corrcoef(error_left, error_right)[0, 1])
                disagreement = float(np.sqrt(np.mean(
                    (self.oof_predictions_[:, left] - self.oof_predictions_[:, right]) ** 2
                )))
                rows.append({
                    "Target": target if target is not None else self.target,
                    "Seed": seed,
                    "Fold": fold,
                    "Model_A": self.base_model_names_[left],
                    "Model_B": self.base_model_names_[right],
                    "OOF_Error_Correlation": correlation,
                    "OOF_Prediction_Disagreement_RMSE": disagreement,
                })
        return pd.DataFrame(rows)

def get_available_models(include_monotonic: bool = True) -> List[GAMModelWrapper]:
    available = []
    model_configs = [
        (EBMWrapper, "interpret", {"monotonic": False}),
        (GAMWrapper, "pygam", {"monotonic": False}),
        (GA2MWrapper, "interpret", {"monotonic": False}),
        (NAMWrapper, "torch", {"monotonic": False}),
    ]
    if include_monotonic:
        model_configs.extend([
            (EBMWrapper, "interpret", {"monotonic": True}),
            (GAMWrapper, "pygam", {"monotonic": True}),
            (GA2MWrapper, "interpret", {"monotonic": True}),
            (NAMWrapper, "torch", {"monotonic": True}),
        ])
    for model_cls, package, kwargs in model_configs:
        try:
            __import__(package)
            m = model_cls(**kwargs)
            available.append(m)
            print(f"  [OK] {m.name} ({package})")
        except ImportError:
            if model_cls is GAMWrapper:
                name = "GAM-Mono" if kwargs.get("monotonic") else "GAM"
            else:
                name = f"{model_cls.__name__.replace('Wrapper', '')}_Mono" if kwargs.get('monotonic') else model_cls.__name__.replace('Wrapper', '')
            print(f"  [SKIP] {name} - {package} not installed")
        except Exception as e:
            if model_cls is GAMWrapper:
                name = "GAM-Mono" if kwargs.get("monotonic") else "GAM"
            else:
                name = f"{model_cls.__name__.replace('Wrapper', '')}_Mono" if kwargs.get('monotonic') else model_cls.__name__.replace('Wrapper', '')
            print(f"  [SKIP] {name} - {type(e).__name__}: {str(e)[:50]}")
    return available


def compute_metrics(y_true: np.ndarray, y_pred: np.ndarray) -> Dict[str, float]:
    return {
        "RMSE": float(np.sqrt(mean_squared_error(y_true, y_pred))),
        "MAE": float(mean_absolute_error(y_true, y_pred)),
        "R2": float(r2_score(y_true, y_pred)),
        "MAPE": float(mean_absolute_percentage_error(y_true, y_pred) * 100),
    }




def _unwrap_ebm(model: GAMModelWrapper):
    """Return the fitted InterpretML EBM object from a model wrapper."""
    return model.model if hasattr(model, "model") else model


def _get_ebm_term_features(ebm) -> List[Tuple[int, ...]]:
    """Return the feature-index tuple associated with each EBM term."""
    term_features = getattr(ebm, "term_features_", None)
    if term_features is None:
        raise AttributeError(
            "The fitted ExplainableBoostingRegressor does not expose term_features_. "
            "Please use a recent InterpretML version."
        )
    return [tuple(int(v) for v in term) for term in term_features]


def _eval_ebm_terms(ebm, X: np.ndarray) -> np.ndarray:
    """
    Evaluate the contribution of every fitted EBM/GA2M term for each sample.

    The preferred API is eval_terms. predict_and_contrib is retained as a
    compatibility fallback for older InterpretML releases.
    """
    X = np.asarray(X, dtype=float)
    term_features = _get_ebm_term_features(ebm)

    if hasattr(ebm, "eval_terms"):
        values = np.asarray(ebm.eval_terms(X), dtype=float)
    elif hasattr(ebm, "predict_and_contrib"):
        output = ebm.predict_and_contrib(X)
        if not isinstance(output, tuple) or len(output) < 2:
            raise RuntimeError("Unexpected predict_and_contrib output from InterpretML.")
        values = np.asarray(output[1], dtype=float)
    else:
        raise AttributeError(
            "The fitted ExplainableBoostingRegressor exposes neither eval_terms "
            "nor predict_and_contrib."
        )

    if values.ndim != 2:
        raise RuntimeError(f"Expected a 2-D term-contribution array, got shape {values.shape}.")

    n_terms = len(term_features)
    if values.shape[1] == n_terms + 1:
        # Some older APIs append an intercept contribution.
        values = values[:, :n_terms]
    if values.shape[1] != n_terms:
        raise RuntimeError(
            f"Term-contribution columns ({values.shape[1]}) do not match "
            f"term_features_ ({n_terms})."
        )
    return values


def _format_term_name(term: Tuple[int, ...]) -> str:
    return " x ".join(FEATURE_COLUMNS[idx].replace("Steam/Biomass", "S/B") for idx in term)


def _target_contribution_label(target: str, prefix: str = "Contribution") -> str:
    if target in {"H2", "CO", "CO2", "CH4"}:
        return f"{prefix} [vol% N$_2$ free]"
    if target == "GY":
        return f"{prefix} [Nm$^3$/kg daf]"
    return prefix


def _get_term_importance_table(model: GAMModelWrapper, X: np.ndarray) -> pd.DataFrame:
    """
    Compute mean absolute term contributions on the supplied observations.

    This ranking is internally consistent across main-effect and pairwise terms
    of the same fitted GA2M/EBM model and is used only for interpretation.
    """
    ebm = _unwrap_ebm(model)
    term_features = _get_ebm_term_features(ebm)
    term_values = _eval_ebm_terms(ebm, X)
    importance = np.mean(np.abs(term_values), axis=0)

    rows = []
    for term_idx, (term, score) in enumerate(zip(term_features, importance)):
        rows.append({
            "TermIndex": term_idx,
            "Term": _format_term_name(term),
            "TermType": "Main effect" if len(term) == 1 else "Pairwise interaction",
            "FeatureIndices": term,
            "Importance": float(score),
        })
    return pd.DataFrame(rows).sort_values("Importance", ascending=False).reset_index(drop=True)













def _make_feature_grid(X: np.ndarray, feature_idx: int, n_grid: int) -> np.ndarray:
    """Create a grid spanning the observed standardized range of one feature."""
    return np.linspace(float(np.min(X[:, feature_idx])), float(np.max(X[:, feature_idx])), n_grid)







def _compute_pairwise_interaction_surface(model: GAMModelWrapper, X: np.ndarray,
                                          scaler: StandardScaler, term_idx: int,
                                          feature_i: int, feature_j: int,
                                          grid_size: int = 50) -> Dict[str, Any]:
    """Evaluate one retained GA2M pairwise term on a continuous/binary grid."""
    ebm = _unwrap_ebm(model)
    observed_terms = _eval_ebm_terms(ebm, X)
    observed_mean = float(np.mean(observed_terms[:, term_idx]))

    def build_grid(feature_idx: int) -> Tuple[np.ndarray, np.ndarray]:
        if feature_idx < N_CONTINUOUS:
            scaled = _make_feature_grid(X, feature_idx, grid_size)
            original = inverse_transform_feature(scaler, feature_idx, scaled)
        else:
            # Bed material is represented by binary one-hot indicators.
            scaled = np.asarray([0.0, 1.0], dtype=float)
            original = scaled.copy()
        return scaled, original

    x_scaled, x_original = build_grid(feature_i)
    y_scaled, y_original = build_grid(feature_j)
    n_x, n_y = len(x_scaled), len(y_scaled)
    Z = np.empty((n_y, n_x), dtype=float)

    for row_idx, y_value in enumerate(y_scaled):
        X_row = np.repeat(X[np.newaxis, :, :], n_x, axis=0)
        X_row[:, :, feature_i] = x_scaled[:, np.newaxis]
        X_row[:, :, feature_j] = y_value
        term_values = _eval_ebm_terms(
            ebm, X_row.reshape(-1, X.shape[1])
        )[:, term_idx]
        Z[row_idx, :] = (
            term_values.reshape(n_x, X.shape[0]).mean(axis=1) - observed_mean
        )

    X_mesh, Y_mesh = np.meshgrid(x_original, y_original)

    def observed_values(feature_idx: int) -> np.ndarray:
        if feature_idx < N_CONTINUOUS:
            return inverse_transform_feature(
                scaler, feature_idx, X[:, feature_idx]
            )
        return np.asarray(X[:, feature_idx], dtype=float)

    return {
        "term_idx": int(term_idx),
        "feature_i": int(feature_i),
        "feature_j": int(feature_j),
        "feature_i_name": FEATURE_COLUMNS[feature_i],
        "feature_j_name": FEATURE_COLUMNS[feature_j],
        "feature_i_is_categorical": bool(feature_i >= N_CONTINUOUS),
        "feature_j_is_categorical": bool(feature_j >= N_CONTINUOUS),
        "x_scaled": x_scaled,
        "y_scaled": y_scaled,
        "x_original": x_original,
        "y_original": y_original,
        "X_mesh": X_mesh,
        "Y_mesh": Y_mesh,
        "Z": Z,
        "observed_x": observed_values(feature_i),
        "observed_y": observed_values(feature_j),
    }

def _draw_interaction_panel(ax, record: Dict[str, Any], target: str,
                            vlim: float, panel_label: str = None,
                            show_title: bool = True):
    """Draw one isolated pairwise interaction panel and return the mappable."""
    vlim = max(float(vlim), 1e-12)
    levels = np.linspace(-vlim, vlim, 21)
    norm = TwoSlopeNorm(vmin=-vlim, vcenter=0.0, vmax=vlim)
    contour = ax.contourf(
        record["X_mesh"], record["Y_mesh"], record["Z"],
        levels=levels, cmap="RdBu_r", norm=norm, extend="both",
    )
    zero_min, zero_max = float(np.nanmin(record["Z"])), float(np.nanmax(record["Z"]))
    if zero_min <= 0 <= zero_max:
        ax.contour(record["X_mesh"], record["Y_mesh"], record["Z"],
                   levels=[0], colors="black", linewidths=0.85, linestyles="-")

    ax.scatter(record["observed_x"], record["observed_y"], s=7,
               facecolors="none", edgecolors="black", linewidths=0.35,
               alpha=0.22, rasterized=True)
    ax.set_xlabel(FEATURE_UNITS.get(record["feature_i_name"], record["feature_i_name"]))
    ax.set_ylabel(FEATURE_UNITS.get(record["feature_j_name"], record["feature_j_name"]))
    if show_title:
        pair_name = (
            f"{record['feature_i_name'].replace('Steam/Biomass', 'S/B')} x "
            f"{record['feature_j_name'].replace('Steam/Biomass', 'S/B')}"
        )
        prefix = f"{panel_label} " if panel_label else ""
        ax.set_title(f"{prefix}{pair_name}", loc="left", fontsize=10.2, fontweight="bold")
    ax.tick_params(which="both", direction="in", top=True, right=True)
    ax.grid(False)
    return contour





















def _progress_log(scope: str, message: str) -> None:
    """Emit an immediately visible, timestamped progress line on local or HPC runs."""
    stamp = time.strftime("%Y-%m-%d %H:%M:%S")
    print(f"[{stamp}] [{scope}] {message}", flush=True)


def _validate_physrate(value: float, context: str = "PhysRate") -> None:
    """Reject accidental mixing of 0-1 fractions and 0-100 percentages."""
    if np.isfinite(value) and (value < -1e-8 or value > 100.0 + 1e-8):
        raise ValueError(f"{context} must use the 0-100 percentage scale; received {value}")


def _format_physrate(value: float) -> str:
    if not np.isfinite(value):
        return "NA"
    _validate_physrate(value)
    return f"{value:.2f}%"


def _run_single_outer_split(df_target: pd.DataFrame, target: str,
                            models: List[GAMModelWrapper], seed: int) -> Dict[str, Any]:
    """Run one independent target/split task; designed for process-level parallelism."""
    split_id = seed + 1
    scope = f"{target} split {split_id:02d}/{len(CFG.SPLIT_SEEDS):02d}"
    task_start = time.time()
    _progress_log(scope, f"started on PID {os.getpid()}")
    results = []
    best = {}
    selected = None
    weight_table = pd.DataFrame()
    diversity_table = pd.DataFrame()
    split_importance_tables = []
    split_shape_tables = []

    try:
        train_idx, test_idx = train_test_split(
            np.arange(len(df_target)),
            test_size=CFG.OUTER_TEST_SIZE,
            random_state=seed,
            shuffle=True,
        )
        train = df_target.iloc[train_idx]
        test = df_target.iloc[test_idx]
        scaler = fit_scaler(train)
        Xtr = transform_features(train, scaler)
        Xte = transform_features(test, scaler)
        ytr = train[target].values
        yte = test[target].values

        mono_library = [model for model in models if model.monotonic]
        if len(mono_library) != 4:
            raise RuntimeError(
                f"Expected four monotonic GAM-family models, found {len(mono_library)}"
            )
        _progress_log(
            scope,
            "stacking library: " + ", ".join(model.name for model in mono_library),
        )
        stack_template = WhiteBoxStackingWrapper(
            mono_library,
            inner_folds=CFG.INNER_CV_FOLDS,
            random_state=seed,
        )
        eval_models = models + [stack_template]

        for model_idx, model in enumerate(eval_models, start=1):
            _progress_log(scope, f"model {model_idx}/{len(eval_models)}: fitting {model.name}")
            try:
                m = model.clone()
                m.fit(Xtr, ytr, target=target)
                pred_train = m.predict(Xtr)
                pred_test = m.predict(Xte)
                train_met = compute_metrics(ytr, pred_train)
                test_met = compute_metrics(yte, pred_test)
                train_phys, _ = check_physical_conformity(m, Xtr, target)
                test_phys, _ = check_physical_conformity(m, Xte, target)
                _validate_physrate(train_phys, f"{m.name} train PhysRate")
                _validate_physrate(test_phys, f"{m.name} test PhysRate")

                row = {
                    "Model": m.name,
                    "Target": target,
                    "Seed": seed,
                    "Fold": split_id,
                    "Train_RMSE": train_met["RMSE"],
                    "Train_MAE": train_met["MAE"],
                    "Train_R2": train_met["R2"],
                    "Train_MAPE": train_met["MAPE"],
                    "Train_PhysRate": train_phys,
                    "Test_RMSE": test_met["RMSE"],
                    "Test_MAE": test_met["MAE"],
                    "Test_R2": test_met["R2"],
                    "Test_MAPE": test_met["MAPE"],
                    "Test_PhysRate": test_phys,
                    "RMSE": test_met["RMSE"],
                    "MAE": test_met["MAE"],
                    "R2": test_met["R2"],
                    "MAPE": test_met["MAPE"],
                    "PhysRate": test_phys,
                    "FitTime": m.fit_time,
                }
                if isinstance(m, WhiteBoxStackingWrapper):
                    row.update({
                        "Stack_Base_Models": "+".join(m.base_model_names_),
                        "Stack_OOF_R2": m.oof_r2_,
                        "Stack_Best_Base_OOF_R2": m.best_base_oof_r2_,
                        "Stack_OOF_Gain": m.oof_gain_,
                        "Stack_Meta_Lambda": m.meta_lambda_,
                        "Stack_Meta_CV_MSE": m.meta_cv_mse_,
                        "Stack_Meta_Strategy": m.meta_strategy_,
                    })
                    weight_table = m.get_weight_table(target=target, seed=seed, fold=split_id)
                    diversity_table = m.get_diversity_table(
                        target=target, seed=seed, fold=split_id, y=ytr
                    )
                    ranked_bases = sorted(
                        m.base_oof_r2_.items(), key=lambda item: item[1], reverse=True
                    )
                    selected = {
                        "Target": target,
                        "Seed": seed,
                        "Fold": split_id,
                        "Library": "+".join(m.base_model_names_),
                        "Best_OOF_Base": ranked_bases[0][0],
                        "Best_Base_OOF_R2": ranked_bases[0][1],
                        "Ensemble_OOF_R2": m.oof_r2_,
                        "OOF_Gain": m.oof_gain_,
                        "Meta_Lambda": m.meta_lambda_,
                        "Meta_CV_MSE": m.meta_cv_mse_,
                        "Meta_Strategy": m.meta_strategy_,
                    }

                if m.name in ("GA2M_Mono", "WhiteBox_Stacking"):
                    try:
                        importance_table = _get_native_main_effect_importance(m, Xtr)
                        importance_table["Target"] = target
                        importance_table["Model"] = m.name
                        importance_table["Seed"] = seed
                        importance_table["Fold"] = split_id
                        split_importance_tables.append(importance_table)

                        shape_table = _compute_main_effect_table(
                            m, Xtr, scaler, target
                        )
                        shape_table["Model"] = m.name
                        shape_table["Seed"] = seed
                        shape_table["Fold"] = split_id
                        split_shape_tables.append(shape_table)
                    except Exception as explanation_error:
                        _progress_log(
                            scope,
                            f"interpretation warning for {m.name}: "
                            f"{type(explanation_error).__name__}: {explanation_error}",
                        )
                results.append(row)

                _progress_log(
                    scope,
                    f"result {m.name}: Test R2={test_met['R2']:.4f}, "
                    f"RMSE={test_met['RMSE']:.4f}, PhysRate={_format_physrate(test_phys)}, "
                    f"fit={m.fit_time:.1f}s",
                )
                if isinstance(m, WhiteBoxStackingWrapper):
                    weights_text = ", ".join(
                        f"{name}={weight:.4f}"
                        for name, weight in zip(m.base_model_names_, m.weights_)
                    )
                    _progress_log(
                        scope,
                        f"stacking OOF R2={m.oof_r2_:.4f}, "
                        f"best-base OOF R2={m.best_base_oof_r2_:.4f}, "
                        f"gain={m.oof_gain_:.4f}, lambda={m.meta_lambda_:g}, "
                        f"strategy={m.meta_strategy_}, weights: {weights_text}",
                    )

                if m.name not in best or test_met["R2"] > best[m.name]["r2"]:
                    best[m.name] = {
                        "r2": test_met["R2"],
                        "seed": seed,
                        "fold": split_id,
                        "scaler": scaler,
                        "y_train": ytr,
                        "y_pred_train": pred_train,
                        "y_test": yte,
                        "y_pred_test": pred_test,
                    }
            except Exception as e:
                _progress_log(scope, f"FAILED {model.name}: {type(e).__name__}: {e}")

        elapsed = time.time() - task_start
        _progress_log(scope, f"completed: {len(results)}/{len(eval_models)} models in {elapsed / 60:.1f} min")
        return {
            "target": target,
