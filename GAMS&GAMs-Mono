def _positive_env_int(names: Tuple[str, ...], default: int) -> int:
    """Read the first positive integer supplied by the scheduler or user."""
    for name in names:
        raw = os.environ.get(name)
        if raw:
            try:
                value = int(raw)
                if value > 0:
                    return value
            except ValueError:
                pass
    return max(1, int(default))


