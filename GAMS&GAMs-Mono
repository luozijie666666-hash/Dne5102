def run_interpretability_robustness_analysis(
        contexts: Dict[str, Dict[str, Any]],
        model_template: GAMModelWrapper,
        output_dir: str) -> None:
    """
    Independently assess the robustness of final full-data GA2M-Mono explanations.

    The full-data model remains the single model used for the manuscript's term
    importance, main-effect, ICE/PDP, and pairwise-surface interpretation. This
    bootstrap stage does not combine explanations from different models into one
    synthetic explanation. It only quantifies sensitivity to sample composition
    through common main-effect rankings, common raw-scale response grids, and
    interaction selection frequencies.
    """
    from scipy.stats import spearmanr

    robustness_root = os.path.join(output_dir, "interpretability_robustness")
    if os.path.exists(robustness_root):
        shutil.rmtree(robustness_root)
    ensure_dir(robustness_root)

    n_boot = int(CFG.ROBUSTNESS_N_BOOTSTRAPS)
    if n_boot < 10:
        raise ValueError("ROBUSTNESS_N_BOOTSTRAPS should be at least 10.")
    q_low, q_high = CFG.ROBUSTNESS_GRID_QUANTILES
    if not (0 <= q_low < q_high <= 1):
        raise ValueError("ROBUSTNESS_GRID_QUANTILES must satisfy 0 <= low < high <= 1.")

    overall_rows = []
    all_run_rows = []
    all_importance_summaries = []
    all_curve_metric_summaries = []
    all_pair_summaries = []

    print("\n[8] Running independent bootstrap robustness analysis...")
    print(f"  Bootstrap refits per target: {n_boot}")

    for target in INTERPRETATION_TARGETS:
        print(f"\n  Robustness target: {target}")
        context = contexts[target]
        full_model = context["model"]
        full_scaler = context["scaler"]
        df_target = context["data"].reset_index(drop=True).copy()
        y_full = df_target[target].to_numpy(dtype=float)
        X_full_reference = transform_features(df_target, full_scaler)
        n_samples = len(df_target)
        target_dir = os.path.join(robustness_root, target)
        ensure_dir(target_dir)

        full_importance = _main_effect_importance_vector(
            full_model, X_full_reference
        )
        full_pair_table = _continuous_pair_importance_table(
            full_model, X_full_reference
        )
        full_rank = full_importance.set_index("Feature")["RankWithinMainEffects"]
        full_top = set(
            full_importance.nsmallest(CFG.ROBUSTNESS_TOP_K,
                                      "RankWithinMainEffects")["Feature"]
        )

        grids = {
            feature_idx: _common_raw_grid(
                df_target, feature_idx, CFG.ROBUSTNESS_GRID_POINTS,
                CFG.ROBUSTNESS_GRID_QUANTILES
            )
            for feature_idx in range(N_CONTINUOUS)
        }
        full_curves = {
            feature_idx: _evaluate_main_effect_on_raw_grid(
                full_model, full_scaler, df_target, feature_idx,
                grids[feature_idx]
            )
            for feature_idx in range(N_CONTINUOUS)
        }

        rng = np.random.default_rng(
            CFG.RANDOM_STATE + 10000 + 1000 * INTERPRETATION_TARGETS.index(target)
        )
        run_rows = []
        importance_rows = []
        curve_rows = []
        curve_metric_rows = []
        pair_rows = []
        error_rows = []

        for boot_idx in range(n_boot):
            replicate = boot_idx + 1
            sample_idx = rng.integers(0, n_samples, size=n_samples)
            unique_idx = np.unique(sample_idx)
            oob_idx = np.setdiff1d(np.arange(n_samples), unique_idx,
                                   assume_unique=False)
            df_boot = df_target.iloc[sample_idx].reset_index(drop=True)

            print(f"    Bootstrap {replicate:03d}/{n_boot}", end="")
            try:
                scaler_boot = fit_scaler(df_boot)
                X_boot = transform_features(df_boot, scaler_boot)
                y_boot = df_boot[target].to_numpy(dtype=float)
                model_boot = model_template.clone()
                model_boot.fit(X_boot, y_boot, target=target)

                X_reference_boot_scale = transform_features(df_target, scaler_boot)
                y_reference_pred = model_boot.predict(X_reference_boot_scale)
                reference_r2 = float(r2_score(y_full, y_reference_pred))
                inbag_r2 = float(r2_score(y_boot, model_boot.predict(X_boot)))
                if len(oob_idx) >= 3:
                    X_oob = transform_features(df_target.iloc[oob_idx], scaler_boot)
                    oob_r2 = float(r2_score(
                        df_target.iloc[oob_idx][target].to_numpy(dtype=float),
                        model_boot.predict(X_oob)
                    ))
                else:
                    oob_r2 = np.nan

                importance = _main_effect_importance_vector(
                    model_boot, X_reference_boot_scale
                )
                importance["Target"] = target
                importance["Bootstrap"] = replicate
                importance_rows.extend(importance.to_dict("records"))

                boot_rank = importance.set_index("Feature")["RankWithinMainEffects"]
                common_features = list(FEATURE_COLUMNS)
                common_display = [v.replace("Steam/Biomass", "S/B")
                                  for v in common_features]
                ranking_spearman = float(spearmanr(
                    [full_rank.loc[v] for v in common_display],
                    [boot_rank.loc[v] for v in common_display]
                ).correlation)
                boot_top = set(
                    importance.nsmallest(CFG.ROBUSTNESS_TOP_K,
                                         "RankWithinMainEffects")["Feature"]
                )
                top_overlap = len(full_top & boot_top) / max(len(full_top), 1)

                replicate_curve_correlations = []
                for feature_idx, feature in enumerate(CONTINUOUS_COLS):
                    curve = _evaluate_main_effect_on_raw_grid(
                        model_boot, scaler_boot, df_target, feature_idx,
                        grids[feature_idx]
                    )
                    metrics = _curve_stability_metrics(
                        full_curves[feature_idx], curve
                    )
                    if np.isfinite(metrics["PearsonCorrelation"]):
                        replicate_curve_correlations.append(
                            metrics["PearsonCorrelation"]
                        )
                    curve_metric_rows.append({
                        "Target": target,
                        "Bootstrap": replicate,
                        "Feature": feature,
                        **metrics,
                    })
                    for x_value, curve_value, full_value in zip(
                            grids[feature_idx], curve,
                            full_curves[feature_idx]):
                        curve_rows.append({
                            "Target": target,
                            "Bootstrap": replicate,
                            "Feature": feature,
                            "X": float(x_value),
                            "BootstrapCurve": float(curve_value),
                            "FullDataCurve": float(full_value),
                        })

                pair_table = _continuous_pair_importance_table(
                    model_boot, X_reference_boot_scale
                )
                for _, pair_row in pair_table.iterrows():
                    pair_rows.append({
                        "Target": target,
                        "Bootstrap": replicate,
                        "PairKey": pair_row["PairKey"],
                        "Pair": pair_row["Pair"],
                        "RawImportance": float(pair_row["RawImportance"]),
                        "ShareOfAllTerms": float(pair_row["ShareOfAllTerms"]),
                        "Rank": int(pair_row["Rank"]),
                    })

                run_row = {
                    "Target": target,
                    "Bootstrap": replicate,
                    "UniqueSamples": int(len(unique_idx)),
                    "UniqueFraction": float(len(unique_idx) / n_samples),
                    "OOBSamples": int(len(oob_idx)),
                    "FitTime": float(model_boot.fit_time),
                    "InBag_R2": inbag_r2,
                    "FullReference_R2": reference_r2,
                    "OOB_R2": oob_r2,
                    "MainEffectRankSpearman": ranking_spearman,
                    "TopKOverlap": float(top_overlap),
                    "MeanMainEffectCurvePearson": (
                        float(np.mean(replicate_curve_correlations))
                        if replicate_curve_correlations else np.nan
                    ),
                    "Status": "OK",
                }
                run_rows.append(run_row)
                print(f"  OK  rank rho={ranking_spearman:.3f}")
            except Exception as exc:
                error_rows.append({
                    "Target": target,
                    "Bootstrap": replicate,
                    "ErrorType": type(exc).__name__,
                    "Error": str(exc),
                })
                run_rows.append({
                    "Target": target,
                    "Bootstrap": replicate,
                    "UniqueSamples": int(len(unique_idx)),
                    "UniqueFraction": float(len(unique_idx) / n_samples),
                    "OOBSamples": int(len(oob_idx)),
                    "Status": "FAILED",
                })
                print(f"  FAILED: {type(exc).__name__}: {exc}")

        run_df = pd.DataFrame(run_rows)
        successful = run_df[run_df["Status"] == "OK"].copy()
        if len(successful) < max(10, int(0.8 * n_boot)):
            raise RuntimeError(
                f"Only {len(successful)}/{n_boot} bootstrap fits succeeded for {target}."
            )
        importance_df = pd.DataFrame(importance_rows)
        curve_df = pd.DataFrame(curve_rows)
        curve_metric_df = pd.DataFrame(curve_metric_rows)
        pair_df = pd.DataFrame(pair_rows)
        error_df = pd.DataFrame(error_rows)

        importance_summary = (
            importance_df.groupby("Feature")["ShareWithinMainEffects"]
            .agg(
                Mean="mean", SD="std", Median="median",
                CI2_5=lambda x: x.quantile(0.025),
                CI97_5=lambda x: x.quantile(0.975),
            )
            .reset_index()
            .rename(columns={"CI2_5": "CI2.5", "CI97_5": "CI97.5"})
        )
        importance_summary = importance_summary.merge(
            full_importance[[
                "Feature", "RawImportance", "ShareOfAllTerms",
                "ShareWithinMainEffects", "RankWithinMainEffects",
            ]].rename(columns={
                "RawImportance": "Full_RawImportance",
                "ShareOfAllTerms": "Full_ShareOfAllTerms",
                "ShareWithinMainEffects": "Full_ShareWithinMainEffects",
                "RankWithinMainEffects": "Full_RankWithinMainEffects",
            }), on="Feature", how="left"
        )

        curve_summary = (
            curve_df.groupby(["Feature", "X"])
            .agg(
                FullDataCurve=("FullDataCurve", "first"),
                Mean=("BootstrapCurve", "mean"),
                SD=("BootstrapCurve", "std"),
                Median=("BootstrapCurve", "median"),
                CI2_5=("BootstrapCurve", lambda x: x.quantile(0.025)),
                CI97_5=("BootstrapCurve", lambda x: x.quantile(0.975)),
            )
            .reset_index()
            .rename(columns={"CI2_5": "CI2.5", "CI97_5": "CI97.5"})
        )
        curve_metric_summary = (
            curve_metric_df.groupby("Feature")
            .agg({
                "PearsonCorrelation": ["mean", "std", "median"],
                "SpearmanCorrelation": ["mean", "std", "median"],
                "NormalizedRMSE": ["mean", "std", "median"],
                "DirectionAgreement": ["mean", "std", "median"],
            })
        )
        curve_metric_summary.columns = [
            "_".join(col).strip() for col in curve_metric_summary.columns
        ]
        curve_metric_summary = curve_metric_summary.reset_index()

        all_pair_keys = {
            f"{i}-{j}": (i, j)
            for i in range(N_CONTINUOUS)
            for j in range(i + 1, N_CONTINUOUS)
        }
        pair_summary_rows = []
        full_pair_map = (
            full_pair_table.set_index("PairKey").to_dict("index")
            if not full_pair_table.empty else {}
        )
        for pair_key, (feature_i, feature_j) in all_pair_keys.items():
            if pair_df.empty:
                selected = pd.DataFrame()
            else:
                selected = pair_df[pair_df["PairKey"] == pair_key]
            full_info = full_pair_map.get(pair_key, {})
            pair_summary_rows.append({
                "PairKey": pair_key,
                "Pair": _format_term_name((feature_i, feature_j)),
                "SelectionCount": int(selected["Bootstrap"].nunique())
                    if not selected.empty else 0,
                "SelectionFrequency": (
                    float(selected["Bootstrap"].nunique() / len(successful))
                    if len(successful) else np.nan
                ),
                "MeanShareWhenSelected": (
                    float(selected["ShareOfAllTerms"].mean())
                    if not selected.empty else 0.0
                ),
                "MeanShareAllBootstraps": (
                    float(selected["ShareOfAllTerms"].sum() / len(successful))
                    if len(successful) else np.nan
                ),
                "FullDataSelected": pair_key in full_pair_map,
                "FullDataShare": float(full_info.get("ShareOfAllTerms", 0.0)),
                "FullDataRank": full_info.get("Rank", np.nan),
            })
        pair_summary = pd.DataFrame(pair_summary_rows).sort_values(
            ["SelectionFrequency", "MeanShareAllBootstraps"], ascending=False
        )

        _plot_bootstrap_importance_stability(
            full_importance, importance_summary, target, target_dir
        )
        _plot_bootstrap_curve_stability(curve_summary, target, target_dir)
        _plot_pairwise_selection_frequency(pair_summary, target, target_dir)

        with pd.ExcelWriter(os.path.join(target_dir, "robustness_results.xlsx")) as writer:
            run_df.to_excel(writer, sheet_name="Bootstrap_runs", index=False)
            full_importance.to_excel(writer, sheet_name="Full_main_importance", index=False)
            importance_df.to_excel(writer, sheet_name="Bootstrap_importance_raw", index=False)
            importance_summary.to_excel(writer, sheet_name="Importance_summary", index=False)
            curve_metric_df.to_excel(writer, sheet_name="Curve_metrics_raw", index=False)
            curve_metric_summary.to_excel(writer, sheet_name="Curve_metrics_summary", index=False)
            curve_df.to_excel(writer, sheet_name="Bootstrap_curves_raw", index=False)
            curve_summary.to_excel(writer, sheet_name="Curve_uncertainty", index=False)
            full_pair_table.to_excel(writer, sheet_name="Full_pair_ranking", index=False)
            pair_df.to_excel(writer, sheet_name="Bootstrap_pairs_raw", index=False)
            pair_summary.to_excel(writer, sheet_name="Pair_selection_summary", index=False)
            if not error_df.empty:
                error_df.to_excel(writer, sheet_name="Errors", index=False)

        successful.to_csv(
            os.path.join(target_dir, "bootstrap_run_summary.csv"),
            index=False, encoding="utf-8-sig"
        )
        importance_summary.to_csv(
            os.path.join(target_dir, "main_effect_importance_summary.csv"),
            index=False, encoding="utf-8-sig"
        )
        curve_metric_summary.to_csv(
            os.path.join(target_dir, "main_effect_curve_metrics.csv"),
            index=False, encoding="utf-8-sig"
        )
        pair_summary.to_csv(
            os.path.join(target_dir, "pairwise_selection_frequency.csv"),
            index=False, encoding="utf-8-sig"
        )

        target_overall = {
            "Target": target,
            "RequestedBootstraps": n_boot,
            "SuccessfulBootstraps": int(len(successful)),
            "MeanMainEffectRankSpearman": float(successful["MainEffectRankSpearman"].mean()),
            "MedianMainEffectRankSpearman": float(successful["MainEffectRankSpearman"].median()),
            "MeanTopKOverlap": float(successful["TopKOverlap"].mean()),
            "MeanMainEffectCurvePearson": float(successful["MeanMainEffectCurvePearson"].mean()),
            "MedianOOB_R2": float(successful["OOB_R2"].median()),
            "MedianFullReference_R2": float(successful["FullReference_R2"].median()),
        }
        overall_rows.append(target_overall)
        all_run_rows.extend(run_df.to_dict("records"))
        temp = importance_summary.copy(); temp.insert(0, "Target", target)
        all_importance_summaries.append(temp)
        temp = curve_metric_summary.copy(); temp.insert(0, "Target", target)
        all_curve_metric_summaries.append(temp)
        temp = pair_summary.copy(); temp.insert(0, "Target", target)
        all_pair_summaries.append(temp)

        print(
            f"    Completed: {len(successful)}/{n_boot} successful; "
            f"mean rank rho={target_overall['MeanMainEffectRankSpearman']:.3f}; "
            f"mean top-{CFG.ROBUSTNESS_TOP_K} overlap={target_overall['MeanTopKOverlap']:.3f}"
        )

    overall_df = pd.DataFrame(overall_rows)
    with pd.ExcelWriter(os.path.join(robustness_root, "robustness_summary.xlsx")) as writer:
        overall_df.to_excel(writer, sheet_name="Target_summary", index=False)
        pd.DataFrame(all_run_rows).to_excel(writer, sheet_name="All_bootstrap_runs", index=False)
        pd.concat(all_importance_summaries, ignore_index=True).to_excel(
            writer, sheet_name="Importance_summary", index=False
        )
        pd.concat(all_curve_metric_summaries, ignore_index=True).to_excel(
            writer, sheet_name="Curve_stability", index=False
        )
        pd.concat(all_pair_summaries, ignore_index=True).to_excel(
            writer, sheet_name="Pair_selection", index=False
        )

    readme_path = os.path.join(
        robustness_root, "README_interpretability_robustness.txt"
    )
    with open(readme_path, "w", encoding="utf-8") as handle:
        handle.write(
            "Independent bootstrap robustness analysis of GA2M-Mono interpretations\n"
            "=======================================================================\n\n"
            f"Bootstrap refits per target: {n_boot}\n"
            f"Random seed: {CFG.RANDOM_STATE}\n"
            f"Main-effect grid: {CFG.ROBUSTNESS_GRID_POINTS} points over the "
            f"{100*q_low:.1f}th-{100*q_high:.1f}th percentiles of each input.\n\n"
            "Purpose\n"
            "-------\n"
            "The manuscript's primary interpretability results remain those from one "
            "GA2M-Mono model refitted on all available samples for each target. Term "
            "importance, main-effect functions, ICE/PDP curves, and pairwise surfaces "
            "therefore remain internally consistent components of the same fitted model.\n\n"
            "This folder contains an independent sensitivity analysis. Bootstrap models "
            "are not averaged into a synthetic interpretation. They are used only to "
            "quantify: (1) stability of the common main-effect ranking, (2) uncertainty "
            "of continuous main-effect functions on common raw-scale grids, and "
            "(3) selection frequency of continuous pairwise interactions.\n\n"
            "Interpretation limits\n"
            "---------------------\n"
            "The reported quantities describe model-specific associations and response "
            "structures. They are not model-independent ground-truth feature importance "
            "and should not be interpreted as causal dose-response relationships. "
            "Bootstrap stability reduces, but does not eliminate, uncertainty arising "
            "from limited sample size, predictor collinearity, and source heterogeneity.\n\n"
            "Folder contents\n"
            "---------------\n"
            "robustness_summary.xlsx: combined results for all gas targets.\n"
            "<target>/robustness_results.xlsx: complete target-specific tables.\n"
            "<target>/main_effect_importance_stability.*: final-model importance and "
            "bootstrap 95% intervals.\n"
            "<target>/main_effect_curve_stability.*: final-model curves and bootstrap "
            "95% uncertainty bands.\n"
            "<target>/pairwise_selection_frequency.*: bootstrap selection frequencies "
            "of continuous pairwise terms.\n"
        )

    print(f"\n  Robustness analysis saved to: {robustness_root}")


def generate_manuscript_figures_v2(df: pd.DataFrame,
                                   models: List[GAMModelWrapper],
                                   output_dir: str,
                                   best_fold_predictions: Dict[str, Dict[str, Dict[str, Any]]] = None) -> None:
    """Generate only the seven manuscript figures and their paired Excel files."""
    _configure_publication_font()
    manuscript_dir = _clean_manuscript_figure_dir(output_dir)
    model_template = next((m for m in models if m.name == "GA2M_Mono"), None)
    if model_template is None:
        raise RuntimeError("GA2M_Mono is unavailable. Install a compatible InterpretML version.")

    feature_tables: Dict[str, pd.DataFrame] = {}
    shape_tables: Dict[str, pd.DataFrame] = {}
    pdp_tables: Dict[str, pd.DataFrame] = {}
    ice_tables: Dict[str, pd.DataFrame] = {}
    contexts: Dict[str, Dict[str, Any]] = {}
    interaction_records: Dict[str, List[Dict[str, Any]]] = {}
    pair_rankings: Dict[str, pd.DataFrame] = {}

    print("\n[7] Refitting GA2M-Mono on all available samples for interpretation...")
    for target in INTERPRETATION_TARGETS:
        print(f"  Target: {target}")
        target_data = split_target(df, target)
        scaler = fit_scaler(target_data)
        X = transform_features(target_data, scaler)
        y = target_data[target].to_numpy(dtype=float)
        model = model_template.clone()
        model.fit(X, y, target=target)
        contexts[target] = {
            "X": X,
            "scaler": scaler,
            "model": model,
            "data": target_data.copy(),
        }
        feature_tables[target] = _get_term_importance_table(model, X)
        shape_tables[target] = _compute_main_effect_table(model, X, scaler, target)
        pdp_tables[target], ice_tables[target] = _compute_ice_pdp_tables(
            model, X, scaler, target
        )
        interaction_records[target], pair_rankings[target] = _compute_top_pairwise_records(
            model, X, scaler, target, top_n=2, grid_size=50
        )

    print("\n  Exporting manuscript-ready figures and Excel files...")
    _plot_fig1_feature_importance(feature_tables, manuscript_dir)
    _plot_shape_matrix(shape_tables, contexts, BIOMASS_FEATURES,
                       manuscript_dir, "Fig2_shape_biomass_characteristics")
    _plot_shape_matrix(shape_tables, contexts, OPERATING_FEATURES,
                       manuscript_dir, "Fig3_shape_operating_parameters")
    _plot_fig4_pairwise(interaction_records, pair_rankings, manuscript_dir)
    if best_fold_predictions is None:
        best_fold_predictions = _load_saved_best_fold_predictions(output_dir)
    _plot_figS1_best_fold(best_fold_predictions, manuscript_dir)
    _plot_ice_pdp_matrix(pdp_tables, ice_tables, BIOMASS_FEATURES,
                         manuscript_dir, "FigS2_ice_pdp_biomass_characteristics")
    _plot_ice_pdp_matrix(pdp_tables, ice_tables, OPERATING_FEATURES,
                         manuscript_dir, "FigS3_ice_pdp_operating_parameters")

    if CFG.RUN_INTERPRETABILITY_ROBUSTNESS:
        run_interpretability_robustness_analysis(
            contexts=contexts,
            model_template=model_template,
            output_dir=output_dir,
        )

    readme = os.path.join(manuscript_dir, "README_manuscript_figures.txt")
    with open(readme, "w", encoding="utf-8") as handle:
        handle.write(
            "This folder contains only manuscript figures and their paired Excel data.\n"
            "Fig1: feature importance (four gas targets)\n"
            "Fig2: main-effect functions of biomass characteristics\n"
            "Fig3: main-effect functions of operating parameters\n"
            "Fig4: three retained pairwise interactions for each gas target; "
            "continuous pairs are prioritized and bed-related retained terms fill missing slots\n"
            "FigS1: predicted-versus-measured plots from saved best-fold predictions\n"
            "FigS2: ICE/PDP of biomass characteristics\n"
            "FigS3: ICE/PDP of operating parameters\n\n"
            "Cross-validation metrics are generated by the full workflow before the interpretation figures.\n"
            "Standalone Table 3 is saved under ../manuscript_tables/.\n"
        )
    print(f"  Done. Manuscript assets: {manuscript_dir}")



def generate_manuscript_table3(df_all: pd.DataFrame, save_dir: str) -> str:
    """
    Export manuscript-ready Table 3 as a standalone Excel workbook.

    The best split for each model-target combination is defined exactly as in the
    prediction-plot workflow: the fold with the highest Test_R2. The value before
    "/" is the five-fold mean, and the value after "/" is the metric from that
    best-performing fold. GY PhysRate is shown as "-" because no directional
    monotonicity constraints are imposed on GY.
    """
    from openpyxl import load_workbook
    from openpyxl.styles import Alignment, Border, Font, PatternFill, Side
    from openpyxl.utils import get_column_letter

    required_cols = {
        "Model", "Target", "Fold",
        "Train_R2", "Train_RMSE", "Train_PhysRate",
        "Test_R2", "Test_RMSE", "Test_PhysRate",
    }
    missing = sorted(required_cols.difference(df_all.columns))
    if missing:
        raise ValueError(f"Cannot generate Table 3; missing columns: {missing}")

    table_dir = os.path.join(save_dir, "manuscript_tables")
    ensure_dir(table_dir)
    output_path = os.path.join(table_dir, "Table3_Predictive_Performance.xlsx")
    csv_path = os.path.join(table_dir, "Table3_Predictive_Performance.csv")

    model_order = [
        "pyGAM", "pyGAM_Mono", "EBM", "EBM_Mono",
        "GA2M", "GA2M_Mono", "NAM", "NAM_Mono",
    ]
    model_display = {
        "pyGAM": "GAM",
        "pyGAM_Mono": "GAM-Mono",
        "EBM": "EBM",
        "EBM_Mono": "EBM-Mono",
        "GA2M": "GA2M",
        "GA2M_Mono": "GA2M-Mono",
        "NAM": "NAM",
        "NAM_Mono": "NAM-Mono",
    }
    target_order = ["H2", "CO", "CO2", "CH4", "GY"]
    metric_rows = [
        ("Train R2 (Average/ Best Split)", "Train_R2", 4),
        ("Train RMSE (Average/ Best Split)", "Train_RMSE", 4),
        ("Train PhysRate (%, Average/ Best Split)", "Train_PhysRate", 2),
        ("Test R2 (Average/ Best Split)", "Test_R2", 4),
        ("Test RMSE (Average/ Best Split)", "Test_RMSE", 4),
        ("Test PhysRate (%, Average/ Best Split)", "Test_PhysRate", 2),
    ]

    display_rows = []
    detail_rows = []
    best_fold_rows = []

    for target in target_order:
        for model in model_order:
            subset = df_all[
                (df_all["Target"] == target) &
                (df_all["Model"] == model)
            ].copy()
            if subset.empty:
                raise ValueError(f"No fold results found for target={target}, model={model}")
            valid_subset = subset.dropna(subset=["Test_R2"])
            if valid_subset.empty:
                raise ValueError(
                    f"All Test_R2 values are missing for target={target}, model={model}"
                )

            best_idx = valid_subset["Test_R2"].astype(float).idxmax()
            best_row = valid_subset.loc[best_idx]
            best_fold_rows.append({
                "Target": target,
                "Model": model_display[model],
                "Best_Fold": int(best_row["Fold"]),
                "Best_Test_R2": float(best_row["Test_R2"]),
            })

            detail = {
                "Target": target,
                "Model": model_display[model],
                "Best_Fold": int(best_row["Fold"]),
            }
            for _, metric_col, _ in metric_rows:
                detail[f"{metric_col}_Average"] = float(subset[metric_col].mean())
                detail[f"{metric_col}_BestSplit"] = float(best_row[metric_col])
            detail_rows.append(detail)

        for metric_label, metric_col, decimals in metric_rows:
            row = {
                "Syngas component": target,
                "Statistical metrics": metric_label,
            }
            for model in model_order:
                subset = df_all[
                    (df_all["Target"] == target) &
                    (df_all["Model"] == model)
                ].copy()
                valid_subset = subset.dropna(subset=["Test_R2"])
                if valid_subset.empty:
                    raise ValueError(
                        f"All Test_R2 values are missing for target={target}, model={model}"
                    )
                best_idx = valid_subset["Test_R2"].astype(float).idxmax()
                best_row = valid_subset.loc[best_idx]

                if target == "GY" and "PhysRate" in metric_col:
                    value = "-"
                else:
                    avg_value = float(subset[metric_col].mean())
                    best_value = float(best_row[metric_col])
                    value = f"{avg_value:.{decimals}f}/{best_value:.{decimals}f}"
                row[model_display[model]] = value
            display_rows.append(row)

    display_columns = (
        ["Syngas component", "Statistical metrics"] +
        [model_display[m] for m in model_order]
    )
    display_df = pd.DataFrame(display_rows, columns=display_columns)
    detail_df = pd.DataFrame(detail_rows)
    best_fold_df = pd.DataFrame(best_fold_rows)
    source_cols = [
        "Target", "Model", "Fold",
        "Train_R2", "Train_RMSE", "Train_PhysRate",
        "Test_R2", "Test_RMSE", "Test_PhysRate",
    ]
    source_df = df_all[source_cols].copy().sort_values(["Target", "Model", "Fold"])

    with pd.ExcelWriter(output_path, engine="openpyxl") as writer:
        display_df.to_excel(writer, sheet_name="Table3", index=False, startrow=1)
        detail_df.to_excel(writer, sheet_name="Numeric_Detail", index=False)
        best_fold_df.to_excel(writer, sheet_name="Best_Fold_Index", index=False)
        source_df.to_excel(writer, sheet_name="Fold_Level_Source", index=False)

    display_df.to_csv(csv_path, index=False, encoding="utf-8-sig")

    # Formatting is optional. The plain workbook and CSV have already been
    # written above, so a version-specific openpyxl formatting problem must
    # never stop the numerical workflow or remove Table 3.
    try:
        wb = load_workbook(output_path)
        ws = wb["Table3"]

        # Title.
        ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=len(display_columns))
        title_cell = ws.cell(1, 1)
        title_cell.value = "Table 3. Predictive Performance of GAMs and GAMs-Mono"
        title_cell.font = Font(name="Arial", size=12, bold=True)
        title_cell.alignment = Alignment(horizontal="center", vertical="center")
        ws.row_dimensions[1].height = 24

        # Styles.
        header_fill = PatternFill("solid", fgColor="1F4E78")
        group_fills = [
            PatternFill("solid", fgColor="EAF2F8"),
            PatternFill("solid", fgColor="F8F9F9"),
        ]
        white_font = Font(name="Arial", size=10, bold=True, color="FFFFFF")
        body_font = Font(name="Arial", size=9)
        thin_gray = Side(style="thin", color="B7B7B7")
        border = Border(left=thin_gray, right=thin_gray, top=thin_gray, bottom=thin_gray)

        header_row = 2
        for cell in ws[header_row]:
            cell.fill = header_fill
            cell.font = white_font
            cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
            cell.border = border
        ws.row_dimensions[header_row].height = 36

        # Merge target labels and apply alternating target-group fills.
        first_data_row = 3
        rows_per_target = len(metric_rows)
        for target_idx, target in enumerate(target_order):
            start_row = first_data_row + target_idx * rows_per_target
            end_row = start_row + rows_per_target - 1
            ws.merge_cells(start_row=start_row, start_column=1, end_row=end_row, end_column=1)
            target_cell = ws.cell(start_row, 1)
            target_cell.value = target
            target_font = Font(name="Arial", size=10, bold=True)
            target_cell.font = target_font
            target_cell.alignment = Alignment(horizontal="center", vertical="center")
            fill = group_fills[target_idx % 2]
            for row_idx in range(start_row, end_row + 1):
                for col_idx in range(1, len(display_columns) + 1):
                    cell = ws.cell(row_idx, col_idx)
                    cell.fill = fill
                    cell.font = body_font if col_idx != 1 else target_font
                    cell.border = border
                    cell.alignment = Alignment(
                        horizontal="left" if col_idx == 2 else "center",
                        vertical="center",
                        wrap_text=True,
                    )
                ws.row_dimensions[row_idx].height = 28

        # Column widths.
        widths = {
            1: 18,
            2: 40,
        }
        for col_idx in range(3, len(display_columns) + 1):
            widths[col_idx] = 16
        for col_idx, width in widths.items():
            ws.column_dimensions[get_column_letter(col_idx)].width = width

        ws.freeze_panes = "C3"
        ws.sheet_view.showGridLines = False
        ws.auto_filter.ref = f"A2:{get_column_letter(len(display_columns))}{ws.max_row}"
        ws.page_setup.orientation = "landscape"
        ws.page_setup.fitToWidth = 1
        ws.page_setup.fitToHeight = 0
        ws.sheet_properties.pageSetUpPr.fitToPage = True
        ws.print_title_rows = "1:2"

        # Format supporting sheets.
        for sheet_name in ["Numeric_Detail", "Best_Fold_Index", "Fold_Level_Source"]:
            sheet = wb[sheet_name]
            sheet.freeze_panes = "A2"
            sheet.sheet_view.showGridLines = False
            for cell in sheet[1]:
                cell.fill = header_fill
                cell.font = white_font
                cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
                cell.border = border
            for row in sheet.iter_rows(min_row=2):
                for cell in row:
                    cell.font = body_font
                    cell.border = border
                    cell.alignment = Alignment(horizontal="center", vertical="center")
                    if isinstance(cell.value, float):
                        cell.number_format = "0.0000"
            for col_idx in range(1, sheet.max_column + 1):
                max_len = max(
                    len(str(sheet.cell(row_idx, col_idx).value or ""))
                    for row_idx in range(1, min(sheet.max_row, 200) + 1)
                )
                sheet.column_dimensions[get_column_letter(col_idx)].width = min(max(max_len + 2, 12), 24)

        wb.save(output_path)
    except Exception as exc:
        print(
            "    WARNING: Table 3 data were exported, but optional Excel "
            f"formatting was skipped: {type(exc).__name__}: {exc}"
        )

    readme_path = os.path.join(table_dir, "README_Table3.txt")
    with open(readme_path, "w", encoding="utf-8") as handle:
        handle.write(
            "Table3_Predictive_Performance.xlsx contains:\n"
            "1. Table3: manuscript-ready Average/Best Split table.\n"
            "2. Numeric_Detail: separate numeric average and best-split values.\n"
            "3. Best_Fold_Index: selected fold for every target-model combination.\n"
            "4. Fold_Level_Source: fold-level source values used to construct Table 3.\n\n"
            "Best split is selected by the highest Test_R2 for each model-target combination.\n"
            "GY PhysRate is displayed as '-' because no monotonic constraints are applied to GY.\n"
        )

    print(f"    Standalone Table 3 saved to: {output_path}")
    return output_path

def _run_original_full_pipeline_then_figures() -> None:
    """Original numerical workflow, followed by the new manuscript figure exporter."""
    set_seed(CFG.RANDOM_STATE)
    ensure_dir(CFG.OUTPUT_DIR)
    print("=" * 60)
    print("Multi-GAM Model Comparison Study")
    print("(With and Without Monotonic Constraints)")
    print("=" * 60)
    print("\n[1] Loading data...")
    df = load_and_prepare_data()
    print("\n[2] Checking available models...")
    models = get_available_models(include_monotonic=True)
    if not models:
        print("ERROR: No models available.")
        return
    print(f"\n{len(models)} model variants available")
    print("\n[3] Running cross-validation...")
    all_results = []
    best_fold_preds_all: Dict[str, Dict] = {}
    for target in TARGETS:
        df_results, best_fold_preds = run_cv_comparison(
            df, target, models, n_folds=CFG.N_FOLDS
        )
        if not df_results.empty:
            all_results.append(df_results)
        best_fold_preds_all[target] = best_fold_preds
    if not all_results:
        print("ERROR: No results.")
        return
    df_all = pd.concat(all_results, ignore_index=True)
    df_all.to_excel(os.path.join(CFG.OUTPUT_DIR, "cv_results_raw.xlsx"), index=False)
    print("\n[4] Aggregating results...")
    df_agg = aggregate_results(df_all)
    df_agg.to_excel(os.path.join(CFG.OUTPUT_DIR, "cv_results_aggregated.xlsx"), index=False)
    print("\n[4.1] Exporting standalone manuscript Table 3...")
    generate_manuscript_table3(df_all, CFG.OUTPUT_DIR)
    print("\n[5] Training final models (scatter plots use best CV fold per model)...")
    for target in TARGETS:
        target_dir = os.path.join(CFG.OUTPUT_DIR, target)
        ensure_dir(target_dir)
        train_final_models(
            df, target, models, target_dir,
            best_fold_preds=best_fold_preds_all.get(target, {})
        )
    print("\n[6] Generating comparison plots...")
    for target in TARGETS:
        plot_comparison_boxplot(df_all, target, CFG.OUTPUT_DIR)
    plot_overall_heatmap(df_agg, "RMSE", CFG.OUTPUT_DIR)
    plot_overall_heatmap(df_agg, "R2", CFG.OUTPUT_DIR)
    plot_overall_heatmap(df_agg, "PhysRate", CFG.OUTPUT_DIR)
    generate_comprehensive_fold_summary(df_all, CFG.OUTPUT_DIR)
    generate_manuscript_figures_v2(
        df, models, CFG.OUTPUT_DIR, best_fold_predictions=best_fold_preds_all
    )
    print("\n" + "=" * 60)
    print(f"Complete! Results saved to: {CFG.OUTPUT_DIR}/")
    print("=" * 60)


def main() -> None:
    """Run the complete numerical and manuscript-figure workflow once."""
    _run_original_full_pipeline_then_figures()


if __name__ == "__main__":
    main()
