    if not split_shapes.empty:
        for target in INTERPRETATION_TARGETS:
            ga2m_table = split_shapes[
                (split_shapes["Target"] == target)
                & (split_shapes["Model"] == "GA2M_Mono")
            ].copy()
            stacking_table = split_shapes[
                (split_shapes["Target"] == target)
                & (split_shapes["Model"] == "WhiteBox_Stacking")
            ].copy()
            if not ga2m_table.empty:
                shape_tables[target] = ga2m_table
            if not stacking_table.empty:
                stacking_shape_tables[target] = stacking_table

    print("\n  Exporting manuscript-ready figures and Excel files...")
